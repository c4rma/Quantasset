//@version=6
indicator("ChartHacker", overlay=true,
          max_bars_back=500, max_lines_count=500,
          max_boxes_count=500, max_labels_count=500)

// ═══════════════════════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════════════════════

// ── VWAP ──────────────────────────────────────────────────────────────────
i_show_vwap    = input.bool(true,  "Show VWAP",            group="VWAP")
i_show_05band  = input.bool(true,  "Show ±0.5σ Band",      group="VWAP")
i_show_2band   = input.bool(true,  "Show ±2σ / ±2.5σ",    group="VWAP")

// ── BIG TRADES ────────────────────────────────────────────────────────────
i_show_btd     = input.bool(true,   "Show Big Trades Detector",  group="Big Trades (Whale) Settings")
i_btd_lookback = input.int(2,       "Lookback Period",           group="Big Trades (Whale) Settings", minval=2)
i_btd_sigma    = input.float(3.0,   "Sensitivity (Sigma)",       group="Big Trades (Whale) Settings", minval=1.0, step=0.1, tooltip="2.0 = Significant, 4.0 = Extreme.")
i_btd_buy_col  = input.color(color.new(color.lime, 20), "Big Buy Color",  group="Big Trades (Whale) Settings")
i_btd_sell_col = input.color(color.new(color.red,  20), "Big Sell Color", group="Big Trades (Whale) Settings")

// ── VOLUME PROFILE ────────────────────────────────────────────────────────
i_show_vp      = input.bool(true,  "Show Volume Profile",  group="Volume Profile")
i_vp_rows      = input.int(50,     "Price Rows",           group="Volume Profile", minval=10, maxval=200)
i_vp_va_pct    = input.float(70.0, "Value Area %",         group="Volume Profile", minval=50.0, maxval=95.0, step=5.0)

// ── SESSIONS ──────────────────────────────────────────────────────────────
i_show_sess  = input.bool(true,   "Show Sessions", group="Sessions")
i_sess_tz    = input.string("America/Chicago", "Timezone", group="Sessions")

i_show_ndo   = input.bool(true,  "", inline="ndo",   group="Sessions")
i_ndo_label  = input.string("NDO",        "", inline="ndo",   group="Sessions")
i_ndo_ses    = input.session("0000-0330",  "", inline="ndo",   group="Sessions")
i_ndo_col    = input.color(color.new(color.blue,    80), "", inline="ndo",   group="Sessions")

i_show_morn  = input.bool(true,  "", inline="morn",  group="Sessions")
i_morn_label = input.string("Morning",    "", inline="morn",  group="Sessions")
i_morn_ses   = input.session("0830-1030",  "", inline="morn",  group="Sessions")
i_morn_col   = input.color(color.new(color.aqua,    80), "", inline="morn",  group="Sessions")

i_show_excl  = input.bool(true,  "", inline="excl",  group="Sessions")
i_excl_label = input.string("Exclusion",  "", inline="excl",  group="Sessions")
i_excl_ses   = input.session("0900-1000",  "", inline="excl",  group="Sessions")
i_excl_col   = input.color(color.new(color.red,     75), "", inline="excl",  group="Sessions")
i_excl_day   = input.string("Wed/Thu", "Excl. Days", group="Sessions",
                 options=["Every Day", "Mon", "Tue", "Wed", "Thu", "Fri", "Wed/Thu"])

i_show_lunch = input.bool(true,  "", inline="lunch", group="Sessions")
i_lunch_label = input.string("Lunch",     "", inline="lunch", group="Sessions")
i_lunch_ses  = input.session("1130-1330",  "", inline="lunch", group="Sessions")
i_lunch_col  = input.color(color.new(color.yellow,  80), "", inline="lunch", group="Sessions")

i_show_pwr   = input.bool(true,  "", inline="pwr",   group="Sessions")
i_pwr_label  = input.string("Power Hour", "", inline="pwr",   group="Sessions")
i_pwr_ses    = input.session("1400-1500",  "", inline="pwr",   group="Sessions")
i_pwr_col    = input.color(color.new(color.fuchsia, 80), "", inline="pwr",   group="Sessions")

i_show_eeod  = input.bool(true,  "", inline="eeod",  group="Sessions")
i_eeod_label = input.string("EEOD",       "", inline="eeod",  group="Sessions")
i_eeod_ses   = input.session("1830-2359",  "", inline="eeod",  group="Sessions")
i_eeod_col   = input.color(color.new(color.green,   80), "", inline="eeod",  group="Sessions")

// NOTE: Volume bars — add TradingView's built-in "Volume" indicator
//       separately. An overlay=true script cannot render a proper sub-pane
//       volume histogram without distorting the price scale.

// ═══════════════════════════════════════════════════════════════════════════
// SESSION DETECTION  (anchor: 19:00 Chicago time = daily CME open)
// ═══════════════════════════════════════════════════════════════════════════

CT = "America/Chicago"

// New session fires on the first bar that crosses 19:00 CT
_sess_bar_ct  = hour(time, CT) * 60 + minute(time, CT)
_sess_bar_ct1 = hour(time[1], CT) * 60 + minute(time[1], CT)
is_new_session = _sess_bar_ct >= 19 * 60 and _sess_bar_ct1 < 19 * 60

// ═══════════════════════════════════════════════════════════════════════════
// VWAP + STANDARD DEVIATION BANDS
// Welford's online volume-weighted variance — same formula as chart.py
// ═══════════════════════════════════════════════════════════════════════════

var float _cum_tpv  = 0.0   // Σ tp * vol
var float _cum_vol  = 0.0   // Σ vol
var float _cum_dev2 = 0.0   // Σ vol * (tp - VWAP)²  (Welford accumulator)

if is_new_session
    _cum_tpv  := 0.0
    _cum_vol  := 0.0
    _cum_dev2 := 0.0

float tp = (high + low + close) / 3.0

float _old_vol = _cum_tpv > 0 ? _cum_vol : 0.0
_cum_tpv += tp * volume
_cum_vol += volume

float vwap_val = na
float vwap_sd  = na

if _cum_vol > 0
    vwap_val := _cum_tpv / _cum_vol
    if _old_vol > 0
        float _old_vwap  = (_cum_tpv - tp * volume) / _old_vol
        _cum_dev2 += volume * (tp - _old_vwap) * (tp - vwap_val)
    vwap_sd := math.sqrt(math.max(0.0, _cum_dev2 / _cum_vol))

float vwap_p05 = i_show_vwap and i_show_05band ? vwap_val + 0.5 * vwap_sd : na
float vwap_m05 = i_show_vwap and i_show_05band ? vwap_val - 0.5 * vwap_sd : na
float vwap_p2  = i_show_vwap and i_show_2band  ? vwap_val + 2.0 * vwap_sd : na
float vwap_m2  = i_show_vwap and i_show_2band  ? vwap_val - 2.0 * vwap_sd : na
float vwap_p25 = i_show_vwap and i_show_2band  ? vwap_val + 2.5 * vwap_sd : na
float vwap_m25 = i_show_vwap and i_show_2band  ? vwap_val - 2.5 * vwap_sd : na

p_vwap = plot(i_show_vwap ? vwap_val : na, "VWAP",   color=color.white,                     linewidth=2)
p_p05  = plot(vwap_p05,                    "+0.5σ",  color=color.new(color.aqua, 60),        linewidth=1)
p_m05  = plot(vwap_m05,                    "−0.5σ",  color=color.new(color.aqua, 60),        linewidth=1)
p_p2   = plot(vwap_p2,                     "+2σ",    color=color.new(color.yellow, 30),      linewidth=1)
p_m2   = plot(vwap_m2,                     "−2σ",    color=color.new(color.yellow, 30),      linewidth=1)
p_p25  = plot(vwap_p25,                    "+2.5σ",  color=color.new(color.yellow, 60),      linewidth=1, style=plot.style_circles)
p_m25  = plot(vwap_m25,                    "−2.5σ",  color=color.new(color.yellow, 60),      linewidth=1, style=plot.style_circles)

fill(p_p05, p_m05, color=color.new(color.aqua, 88), title="0.5σ Fill")

// ═══════════════════════════════════════════════════════════════════════════
// BIG TRADES DETECTOR — volume intensity z-score, tiered bubbles
// Compares current bar against PREVIOUS bars [1] for real-time accuracy.
// Bubbles placed at avg(close,low) for buys / avg(close,high) for sells.
// ═══════════════════════════════════════════════════════════════════════════

float _btd_range = high - low

float raw_buy_vol  = _btd_range == 0 ? 0.0 : (close - low)  / _btd_range * volume
float raw_sell_vol = _btd_range == 0 ? 0.0 : (high - close) / _btd_range * volume

// Stats against the previous lookback window (not the current bar)
float avg_buy_vol  = ta.sma(raw_buy_vol,   i_btd_lookback)[1]
float std_buy_vol  = ta.stdev(raw_buy_vol, i_btd_lookback)[1]
float avg_sell_vol = ta.sma(raw_sell_vol,   i_btd_lookback)[1]
float std_sell_vol = ta.stdev(raw_sell_vol, i_btd_lookback)[1]

float thresh_buy  = avg_buy_vol  + std_buy_vol  * i_btd_sigma
float thresh_sell = avg_sell_vol + std_sell_vol * i_btd_sigma

bool is_bt_buy_t1  = raw_buy_vol  > thresh_buy
bool is_bt_buy_t2  = raw_buy_vol  > avg_buy_vol  + std_buy_vol  * (i_btd_sigma + 1.5)
bool is_bt_buy_t3  = raw_buy_vol  > avg_buy_vol  + std_buy_vol  * (i_btd_sigma + 3.0)
bool is_bt_sell_t1 = raw_sell_vol > thresh_sell
bool is_bt_sell_t2 = raw_sell_vol > avg_sell_vol + std_sell_vol * (i_btd_sigma + 1.5)
bool is_bt_sell_t3 = raw_sell_vol > avg_sell_vol + std_sell_vol * (i_btd_sigma + 3.0)

// Bubble Y-positions: buys cluster near low side, sells near high side
float pos_buy  = math.avg(close, low)
float pos_sell = math.avg(close, high)

// BUYS
plotshape(i_show_btd and is_bt_buy_t1 and not is_bt_buy_t2 ? pos_buy : na, title="Big Buy (Small)", style=shape.circle, location=location.absolute, color=i_btd_buy_col,  size=size.small)
plotshape(i_show_btd and is_bt_buy_t2 and not is_bt_buy_t3 ? pos_buy : na, title="Big Buy (Med)",   style=shape.circle, location=location.absolute, color=i_btd_buy_col,  size=size.normal)
plotshape(i_show_btd and is_bt_buy_t3                      ? pos_buy : na, title="Big Buy (Large)", style=shape.circle, location=location.absolute, color=i_btd_buy_col,  size=size.large)

// SELLS
plotshape(i_show_btd and is_bt_sell_t1 and not is_bt_sell_t2 ? pos_sell : na, title="Big Sell (Small)", style=shape.circle, location=location.absolute, color=i_btd_sell_col, size=size.small)
plotshape(i_show_btd and is_bt_sell_t2 and not is_bt_sell_t3 ? pos_sell : na, title="Big Sell (Med)",   style=shape.circle, location=location.absolute, color=i_btd_sell_col, size=size.normal)
plotshape(i_show_btd and is_bt_sell_t3                        ? pos_sell : na, title="Big Sell (Large)", style=shape.circle, location=location.absolute, color=i_btd_sell_col, size=size.large)

// ═══════════════════════════════════════════════════════════════════════════
// SESSIONS WITH EXCLUSIONS
// ═══════════════════════════════════════════════════════════════════════════

_tf = timeframe.period

bool _is_ndo   = i_show_sess and i_show_ndo   and math.sign(nz(time(_tf, i_ndo_ses,   i_sess_tz))) > 0
bool _is_morn  = i_show_sess and i_show_morn  and math.sign(nz(time(_tf, i_morn_ses,  i_sess_tz))) > 0
bool _is_lunch = i_show_sess and i_show_lunch and math.sign(nz(time(_tf, i_lunch_ses, i_sess_tz))) > 0
bool _is_pwr   = i_show_sess and i_show_pwr   and math.sign(nz(time(_tf, i_pwr_ses,   i_sess_tz))) > 0
bool _is_eeod  = i_show_sess and i_show_eeod  and math.sign(nz(time(_tf, i_eeod_ses,  i_sess_tz))) > 0

bool _excl_time  = math.sign(nz(time(_tf, i_excl_ses, i_sess_tz))) > 0
bool _excl_day_ok = switch i_excl_day
    "Mon"     => dayofweek == dayofweek.monday
    "Tue"     => dayofweek == dayofweek.tuesday
    "Wed"     => dayofweek == dayofweek.wednesday
    "Thu"     => dayofweek == dayofweek.thursday
    "Fri"     => dayofweek == dayofweek.friday
    "Wed/Thu" => dayofweek == dayofweek.wednesday or dayofweek == dayofweek.thursday
    => true  // "Every Day"

bool _is_excl = i_show_sess and i_show_excl and _excl_time and _excl_day_ok

bgcolor(_is_ndo   ? i_ndo_col   : na, title="NDO")
bgcolor(_is_morn  ? i_morn_col  : na, title="Morning")
bgcolor(_is_lunch ? i_lunch_col : na, title="Lunch")
bgcolor(_is_pwr   ? i_pwr_col   : na, title="Power Hour")
bgcolor(_is_eeod  ? i_eeod_col  : na, title="EEOD")
bgcolor(_is_excl  ? i_excl_col  : na, title="Exclusion")

// ═══════════════════════════════════════════════════════════════════════════
// VOLUME PROFILE — session-based, POC / VAH / VAL
// Accumulates per-bar into price buckets. Finalizes at next session open,
// then draws horizontal lines extending right until price touches them.
// Logic mirrors chart.py:1468-1576 (50% wick / 50% body volume split,
// 70% value area).
// ═══════════════════════════════════════════════════════════════════════════

int   VP_ROWS = i_vp_rows

// Per-session accumulators
var float[] _vp_vol  = array.new_float(0)   // bucket volume totals
var float   _vp_slo  = na                    // session low
var float   _vp_shi  = na                    // session high
var float   _vp_tvol = 0.0                   // session total volume

// Active VP level lines + labels (POC, VAH, VAL) — managed across sessions
var line  _poc_line  = na
var line  _vah_line  = na
var line  _val_line  = na
var label _poc_label = na
var label _vah_label = na
var label _val_label = na

// ── Helpers ──────────────────────────────────────────────────────────────

f_bucket(float p, float lo, float hi, int rows) =>
    hi > lo ? math.max(0, math.min(rows - 1, int((p - lo) / (hi - lo) * (rows - 1)))) : 0

// Distribute vol evenly across bucket range [b0, b1] inclusive
f_fill_range(float[] arr, int b0, int b1, float vol_share) =>
    int n = math.abs(b1 - b0) + 1
    float per = vol_share / n
    int lo_b = math.min(b0, b1)
    int hi_b = math.max(b0, b1)
    for i = lo_b to hi_b
        array.set(arr, i, array.get(arr, i) + per)

// Find POC index (max volume bucket)
f_poc(float[] arr) =>
    int poc_i = 0
    float poc_v = 0.0
    for i = 0 to array.size(arr) - 1
        float v = array.get(arr, i)
        if v > poc_v
            poc_v := v
            poc_i := i
    poc_i

// Find VAH/VAL bucket indices enclosing va_pct% of total volume around POC
f_value_area(float[] arr, int poc_i, float va_pct) =>
    float total = array.sum(arr)
    float target = total * va_pct / 100.0
    int   rows   = array.size(arr)
    int   lo_i   = poc_i
    int   hi_i   = poc_i
    float accum  = array.get(arr, poc_i)
    while accum < target and (lo_i > 0 or hi_i < rows - 1)
        float add_lo = lo_i > 0         ? array.get(arr, lo_i - 1) : 0.0
        float add_hi = hi_i < rows - 1  ? array.get(arr, hi_i + 1) : 0.0
        if add_hi >= add_lo
            hi_i  := hi_i + 1
            accum += add_hi
        else
            lo_i  := lo_i - 1
            accum += add_lo
    [lo_i, hi_i]

// ── Reset on new session ─────────────────────────────────────────────────

if is_new_session and i_show_vp
    // Finalize previous session: compute POC/VAH/VAL and draw lines
    if array.size(_vp_vol) == VP_ROWS and not na(_vp_slo) and not na(_vp_shi) and _vp_tvol > 0
        int poc_i = f_poc(_vp_vol)
        [val_i, vah_i] = f_value_area(_vp_vol, poc_i, i_vp_va_pct)

        float s_range  = _vp_shi - _vp_slo
        float poc_p = _vp_slo + (poc_i + 0.5) / VP_ROWS * s_range
        float vah_p = _vp_slo + (vah_i + 0.5) / VP_ROWS * s_range
        float val_p = _vp_slo + (val_i + 0.5) / VP_ROWS * s_range

        // Delete previous lines and labels before drawing new ones
        if not na(_poc_line)
            line.delete(_poc_line)
        if not na(_vah_line)
            line.delete(_vah_line)
        if not na(_val_line)
            line.delete(_val_line)
        if not na(_poc_label)
            label.delete(_poc_label)
        if not na(_vah_label)
            label.delete(_vah_label)
        if not na(_val_label)
            label.delete(_val_label)

        _poc_line  := line.new(bar_index, poc_p, bar_index, poc_p,
                               color=color.red,  width=2, style=line.style_solid, extend=extend.right)
        _vah_line  := line.new(bar_index, vah_p, bar_index, vah_p,
                               color=color.blue, width=1, style=line.style_solid, extend=extend.right)
        _val_line  := line.new(bar_index, val_p, bar_index, val_p,
                               color=color.blue, width=1, style=line.style_solid, extend=extend.right)

        _poc_label := label.new(bar_index, poc_p, "POC: " + str.tostring(poc_p, format.mintick),
                                color=color.red,  textcolor=color.white,
                                style=label.style_label_right, size=size.small)
        _vah_label := label.new(bar_index, vah_p, "VAH: " + str.tostring(vah_p, format.mintick),
                                color=color.blue, textcolor=color.white,
                                style=label.style_label_right, size=size.small)
        _val_label := label.new(bar_index, val_p, "VAL: " + str.tostring(val_p, format.mintick),
                                color=color.blue, textcolor=color.white,
                                style=label.style_label_right, size=size.small)

    // Reset accumulators for the new session
    array.clear(_vp_vol)
    for _r = 0 to VP_ROWS - 1
        array.push(_vp_vol, 0.0)
    _vp_slo  := low
    _vp_shi  := high
    _vp_tvol := 0.0

// ── Initialize on very first bar ────────────────────────────────────────

if array.size(_vp_vol) == 0 and i_show_vp
    for _r = 0 to VP_ROWS - 1
        array.push(_vp_vol, 0.0)
    _vp_slo := low
    _vp_shi := high

// ── Accumulate current bar into buckets ─────────────────────────────────

if i_show_vp and array.size(_vp_vol) == VP_ROWS and not na(_vp_slo)
    _vp_slo  := math.min(_vp_slo, low)
    _vp_shi  := math.max(_vp_shi, high)
    _vp_tvol += volume

    // 50% of volume spread over wick range, 50% over body range
    // (matches chart.py VP_BUCKETS logic)
    float half_vol = volume * 0.5
    float body_lo  = math.min(open, close)
    float body_hi  = math.max(open, close)

    int wb0 = f_bucket(low,     _vp_slo, _vp_shi, VP_ROWS)
    int wb1 = f_bucket(high,    _vp_slo, _vp_shi, VP_ROWS)
    int bb0 = f_bucket(body_lo, _vp_slo, _vp_shi, VP_ROWS)
    int bb1 = f_bucket(body_hi, _vp_slo, _vp_shi, VP_ROWS)

    f_fill_range(_vp_vol, wb0, wb1, half_vol)
    f_fill_range(_vp_vol, bb0, bb1, half_vol)

// ── Extend / expire level lines when price trades through them ───────────
// Virgin POC/VAH/VAL: stop extending once touched (mimics chart.py virgin lines)

if i_show_vp and barstate.isconfirmed
    if not na(_poc_line)
        float poc_lvl = line.get_price(_poc_line, bar_index)
        if low <= poc_lvl and poc_lvl <= high
            line.set_extend(_poc_line, extend.none)
    if not na(_vah_line)
        float vah_lvl = line.get_price(_vah_line, bar_index)
        if low <= vah_lvl and vah_lvl <= high
            line.set_extend(_vah_line, extend.none)
    if not na(_val_line)
        float val_lvl = line.get_price(_val_line, bar_index)
        if low <= val_lvl and val_lvl <= high
            line.set_extend(_val_line, extend.none)
