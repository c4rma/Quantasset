//@version=6
indicator("ChartHacker", overlay=true,
          max_bars_back=5000, max_lines_count=500,
          max_boxes_count=500, max_labels_count=500)

// Per-session volume profile data
type VPSession
    int     start_bi = 0
    int     end_bi   = 0
    float   rlo      = 0.0
    float   step_sz  = 0.0
    float   poc_p    = 0.0
    float   vah_p    = 0.0
    float   val_p    = 0.0
    int     vah_i    = 0
    int     val_i    = 0
    float[] vols     = na

// ═══════════════════════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════════════════════

// ── GENERAL ───────────────────────────────────────────────────────────────
i_asset_mode = input.string("Crypto", "Asset Mode", group="General",
                 options=["Crypto", "Equities"],
                 tooltip="Crypto: new day at 19:00 CT (CME futures open), anchored to candle open.\nEquities: new day at 16:00 CT (market close), anchored to candle close.")

// ── VWAP ──────────────────────────────────────────────────────────────────
i_show_vwap   = input.bool(true,  "Show VWAP",         group="VWAP")
i_show_05band = input.bool(true,  "Show ±0.5σ Band",   group="VWAP")
i_show_2band  = input.bool(true,  "Show ±2σ / ±2.5σ", group="VWAP")

// ── BIG TRADES ────────────────────────────────────────────────────────────
i_show_btd     = input.bool(true,  "Show Big Trades Detector", group="Big Trades (Whale) Settings")
i_btd_lookback = input.int(2,      "Lookback Period",          group="Big Trades (Whale) Settings", minval=2)
i_btd_sigma    = input.float(2.5,  "Sensitivity (Sigma)",      group="Big Trades (Whale) Settings", minval=1.0, step=0.1, tooltip="2.0 = Significant, 4.0 = Extreme.")
i_btd_buy_col  = input.color(color.new(color.lime, 20), "Big Buy Color",  group="Big Trades (Whale) Settings")
i_btd_sell_col = input.color(color.new(color.red,  20), "Big Sell Color", group="Big Trades (Whale) Settings")

// ── MOVING AVERAGE ────────────────────────────────────────────────────────
i_show_ma  = input.bool(true,    "Show MA",   group="Moving Average")
i_ma_type  = input.string("EMA", "Type",      group="Moving Average", options=["SMA", "EMA"])
i_ma_len   = input.int(20,       "Length",    group="Moving Average", minval=1)
i_ma_col   = input.color(color.new(color.white, 0), "Color", group="Moving Average")
i_ma_width = input.int(1,        "Thickness", group="Moving Average", minval=1, maxval=5)

// ── LEVELS ────────────────────────────────────────────────────────────────
i_show_buy_lvl  = input.bool(true, "", inline="buylvl",  group="Levels")
i_buy_lvl       = input.price(0.0, "Buy Territory",  inline="buylvl",  group="Levels")
i_show_sell_lvl = input.bool(true, "", inline="selllvl", group="Levels")
i_sell_lvl      = input.price(0.0, "Sell Territory", inline="selllvl", group="Levels")

// ── EXPECTED RANGE ────────────────────────────────────────────────────────
i_show_er      = input.bool(true,           "Show Expected Range",    group="Expected Range")
i_er_iv_sym    = input.symbol("DERIBIT:ETHDVOL", "IV Symbol (DVOL)", group="Expected Range", tooltip="Used in Crypto mode.")
i_er_iv_manual = input.float(50.0,          "Manual IV (%)",          group="Expected Range", minval=1.0, maxval=999.0, step=0.5, tooltip="Annual implied volatility in percent (e.g. 50 = 50%). Used in Equities mode.")
i_show_dvol_db = input.bool(true,           "Show DVOL Dashboard",   group="Expected Range")

// ── SESSIONS ──────────────────────────────────────────────────────────────
i_show_sess   = input.bool(true,                 "Show Sessions",          group="Sessions")
i_sess_tz     = input.string("America/Chicago",  "Timezone",               group="Sessions")
bg_transp     = input.float(85.0,                "Range Transparency",     group="Sessions", minval=0, maxval=100)
show_outline  = input.bool(true,                 "Range Outline",          group="Sessions")
show_txt      = input.bool(true,                 "Range Label",            group="Sessions")
show_day_div  = input.bool(true,                 "Show Daily Divider",     group="Sessions")
i_show_so     = input.bool(true,                 "Show Session Open Line", group="Sessions")

i_show_ndo    = input.bool(true,  "", inline="ndo",   group="Sessions")
i_ndo_label   = input.string("NDO",        "", inline="ndo",   group="Sessions")
i_ndo_ses     = input.session("0000-0330", "", inline="ndo",   group="Sessions")
i_ndo_col     = input.color(color.new(color.blue,    80), "", inline="ndo",   group="Sessions")

i_show_morn   = input.bool(true,  "", inline="morn",  group="Sessions")
i_morn_label  = input.string("Morning",    "", inline="morn",  group="Sessions")
i_morn_ses    = input.session("0830-1030", "", inline="morn",  group="Sessions")
i_morn_col    = input.color(color.new(color.aqua,    80), "", inline="morn",  group="Sessions")

i_show_excl   = input.bool(true,  "", inline="excl",  group="Sessions")
i_excl_label  = input.string("Exclusion", "", inline="excl",  group="Sessions")
i_excl_ses    = input.session("0900-1000", "", inline="excl",  group="Sessions")
i_excl_col    = input.color(color.new(color.red,     75), "", inline="excl",  group="Sessions")
i_excl_day    = input.string("Wed/Thu", "Excl. Days", group="Sessions",
                  options=["Every Day", "Mon", "Tue", "Wed", "Thu", "Fri", "Wed/Thu"])

i_show_lunch  = input.bool(true,  "", inline="lunch", group="Sessions")
i_lunch_label = input.string("Lunch",     "", inline="lunch", group="Sessions")
i_lunch_ses   = input.session("1130-1330", "", inline="lunch", group="Sessions")
i_lunch_col   = input.color(color.new(color.yellow,  80), "", inline="lunch", group="Sessions")

i_show_pwr    = input.bool(true,  "", inline="pwr",   group="Sessions")
i_pwr_label   = input.string("Power Hour","", inline="pwr",   group="Sessions")
i_pwr_ses     = input.session("1400-1500", "", inline="pwr",   group="Sessions")
i_pwr_col     = input.color(color.new(color.fuchsia, 80), "", inline="pwr",   group="Sessions")

i_show_eeod   = input.bool(true,  "", inline="eeod",  group="Sessions")
i_eeod_label  = input.string("EEOD",      "", inline="eeod",  group="Sessions")
i_eeod_ses    = input.session("1830-2359", "", inline="eeod",  group="Sessions")
i_eeod_col    = input.color(color.new(color.green,   80), "", inline="eeod",  group="Sessions")

// NOTE: Add TradingView's built-in "Volume" indicator separately for volume bars.

// ── VOLUME PROFILE ────────────────────────────────────────────────────────
i_show_vp       = input.bool(false,    "Show Volume Profile",   group="Volume Profile")
i_vp_period     = input.string("Day",  "Period",                group="Volume Profile", options=["Day", "Custom"])
i_vp_length     = input.int(200,       "Custom Length (bars)",  group="Volume Profile", minval=10, maxval=500, tooltip="Only used when Period is 'Custom'.")
i_vp_rows       = input.int(50,        "Rows",                  group="Volume Profile", minval=10, maxval=130)
i_vp_placement  = input.string("Right","Placement",             group="Volume Profile", options=["Right", "Left"])
i_vp_width      = input.int(80,        "Profile Width (bars)",  group="Volume Profile", minval=5, maxval=500, tooltip="Visual width of the profile in bar units.")
i_vp_offset     = input.int(5,         "Right Offset (bars)",  group="Volume Profile", minval=0, maxval=50, tooltip="Gap between last candle and profile. Only used when Placement is 'Right'.")
i_vp_va_pct     = input.float(70.0,   "Value Area %",          group="Volume Profile", minval=1.0, maxval=99.0)
i_show_poc      = input.bool(true,     "",                      inline="poc",    group="Volume Profile")
i_poc_col       = input.color(color.red,   "POC",              inline="poc",    group="Volume Profile")
i_poc_width     = input.int(3,         "Width",                inline="poc",    group="Volume Profile", minval=1, maxval=5)
i_show_vah_val  = input.bool(true,     "",                      inline="vahval", group="Volume Profile")
i_vah_val_col   = input.color(#2962ff, "VAH / VAL",            inline="vahval", group="Volume Profile")
i_vah_val_width = input.int(3,         "Width",                inline="vahval", group="Volume Profile", minval=1, maxval=5)
i_vp_hist_mode  = input.bool(false,    "Historical Mode",       group="Volume Profile",
                   tooltip="Plots developing POC/VAH/VAL step lines that evolve bar-by-bar throughout each session.")

// ── ALERTS ────────────────────────────────────────────────────────────────
i_alerts_on   = input.bool(false, "Enable Alerts", group="Alerts",
                 tooltip="Fires alerts automatically at candle close for each checked type below.\nSetup: create ONE TradingView alert on this indicator with condition 'Any alert() function call'.")
i_al_er_40    = input.bool(true,  "ER 40% Cross",   group="Alerts")
i_al_er_80    = input.bool(true,  "ER 80% Cross",   group="Alerts")
i_al_er_100   = input.bool(true,  "ER 100% Cross",  group="Alerts")
i_al_er_150   = input.bool(true,  "ER 150% Cross",  group="Alerts")
i_al_vp_poc   = input.bool(true,  "VP POC Cross",   group="Alerts")
i_al_vp_vah   = input.bool(true,  "VP VAH Cross",   group="Alerts")
i_al_vp_val   = input.bool(true,  "VP VAL Cross",   group="Alerts")
i_al_bt_buy   = input.bool(true,  "Big Buy Trade",  group="Alerts")
i_al_bt_sell  = input.bool(true,  "Big Sell Trade", group="Alerts")

// ── VP helper: compute a complete VPSession from bar arrays ───────────────
f_vp_compute(float[] bh, float[] bl, float[] bv, int s_bi, int e_bi, int rows, float va_pct) =>
    int     _n    = bh.size()
    float   _rlo  = _n > 0 ? bl.min()  : 0.0
    float   _rhi  = _n > 0 ? bh.max()  : 0.0
    float   _step = _n > 0 and _rhi > _rlo ? (_rhi - _rlo) / rows : 1.0
    float[] _vs   = array.new_float(rows, 0.0)
    if _n > 0
        for _bi = 0 to _n - 1
            float _lh = bh.get(_bi), float _ll = bl.get(_bi), float _lv = bv.get(_bi)
            if _lh > _ll
                int _s = math.max(int(math.floor((_ll - _rlo) / _step)), 0)
                int _e = math.min(int(math.floor((_lh - _rlo) / _step)), rows - 1)
                for _pi = _s to _e
                    float _pl = _rlo + _pi * _step
                    float _pp = switch
                        _ll >= _pl and _lh > _pl + _step  => (_pl + _step - _ll) / (_lh - _ll)
                        _lh <= _pl + _step and _ll < _pl  => (_lh - _pl) / (_lh - _ll)
                        _ll >= _pl and _lh <= _pl + _step => 1.0
                        => _step / (_lh - _ll)
                    _vs.set(_pi, _vs.get(_pi) + _lv * _pp)
    float _mv  = _vs.max()
    int   _pi  = _vs.indexof(_mv)
    float _vt  = _vs.sum() * (va_pct / 100.0)
    float _vv  = _vs.get(_pi)
    int   _vhi = _pi, int _vli = _pi
    while _vv < _vt
        if _vli == 0 and _vhi == rows - 1
            break
        float _up = _vhi < rows - 1 ? _vs.get(_vhi + 1) : 0.0
        float _dn = _vli > 0        ? _vs.get(_vli - 1) : 0.0
        if _up == 0.0 and _dn == 0.0
            break
        if _up >= _dn
            _vv += _up
            _vhi += 1
        else
            _vv += _dn
            _vli -= 1
    VPSession.new(s_bi, e_bi, _rlo, _step,
                  _rlo + (_pi  + 0.5) * _step,
                  _rlo + (_vhi + 1.0) * _step,
                  _rlo +  _vli        * _step,
                  _vhi, _vli, _vs)

// ═══════════════════════════════════════════════════════════════════════════
// SESSION BOUNDARY  (anchor: 19:00 Chicago = CME daily open)
// ═══════════════════════════════════════════════════════════════════════════

CT = "America/Chicago"
_ct_now   = hour(time, CT) * 60 + minute(time, CT)
_ct_prev  = hour(time[1], CT) * 60 + minute(time[1], CT)
int _sess_boundary = i_asset_mode == "Equities" ? 16 * 60 : 19 * 60
is_new_session = _ct_now >= _sess_boundary and _ct_prev < _sess_boundary

// VP state — current session accumulation + completed session history
var float[]      _vp_d_hi   = array.new_float(0)
var float[]      _vp_d_lo   = array.new_float(0)
var float[]      _vp_d_vol  = array.new_float(0)
var int          _vp_d_start = 0
var VPSession[]  _vp_hist   = array.new<VPSession>(0)
// VP drawing-object handles
var box[]  _vp_boxes   = array.new<box>()
var line[] _vp_poc_lns = array.new<line>()
var line[] _vp_vah_lns = array.new<line>()
var line[] _vp_val_lns = array.new<line>()
var label  _vp_poc_lbl = na
var label  _vp_vah_lbl = na
var label  _vp_val_lbl = na

bool _vp_16ct = _ct_now >= 16 * 60 and _ct_prev < 16 * 60

if i_show_vp and i_vp_period == "Day"
    if _vp_16ct
        // Finalise the session that just ended and store it
        if _vp_d_hi.size() > 0
            _vp_hist.push(f_vp_compute(_vp_d_hi, _vp_d_lo, _vp_d_vol,
                                        _vp_d_start, bar_index - 1,
                                        i_vp_rows, i_vp_va_pct))
        _vp_d_hi.clear()
        _vp_d_lo.clear()
        _vp_d_vol.clear()
        _vp_d_start := bar_index
    _vp_d_hi.push(high)
    _vp_d_lo.push(low)
    _vp_d_vol.push(volume)

// ── Developing (Historical Mode) VP — incremental bucket update every bar ──
var float   _dv_rlo  = na
var float   _dv_rhi  = na
var float   _dv_step = 0.0
var float[] _dv_bkts = array.new_float(0)
var float   _dv_poc  = na
var float   _dv_vah  = na
var float   _dv_val  = na

if i_show_vp and i_vp_period == "Day"
    bool _dv_new = _vp_16ct or na(_dv_rlo)
    bool _dv_out = not _dv_new and (low < _dv_rlo or high > _dv_rhi)
    if _dv_new
        _dv_rlo  := low
        _dv_rhi  := high
        float _r  = high - low
        _dv_step := _r > 0 ? _r / i_vp_rows : syminfo.mintick * i_vp_rows
        _dv_bkts := array.new_float(i_vp_rows, 0.0)
    else if _dv_out
        _dv_rlo  := math.min(_dv_rlo, low)
        _dv_rhi  := math.max(_dv_rhi, high)
        float _r  = _dv_rhi - _dv_rlo
        _dv_step := _r > 0 ? _r / i_vp_rows : syminfo.mintick * i_vp_rows
        _dv_bkts := array.new_float(i_vp_rows, 0.0)
    bool _dv_rebuild = _dv_new or _dv_out
    int  _dv_nb = _vp_d_hi.size()
    if _dv_rebuild and _dv_nb > 0 and _dv_step > 0
        for _bi = 0 to _dv_nb - 1
            float _lh = _vp_d_hi.get(_bi), float _ll = _vp_d_lo.get(_bi), float _lv = _vp_d_vol.get(_bi)
            if _lh > _ll
                int _s = math.max(int(math.floor((_ll - _dv_rlo) / _dv_step)), 0)
                int _e = math.min(int(math.floor((_lh - _dv_rlo) / _dv_step)), i_vp_rows - 1)
                for _pi = _s to _e
                    float _pl = _dv_rlo + _pi * _dv_step
                    float _pp = switch
                        _ll >= _pl and _lh > _pl + _dv_step  => (_pl + _dv_step - _ll) / (_lh - _ll)
                        _lh <= _pl + _dv_step and _ll < _pl  => (_lh - _pl) / (_lh - _ll)
                        _ll >= _pl and _lh <= _pl + _dv_step => 1.0
                        => _dv_step / (_lh - _ll)
                    _dv_bkts.set(_pi, _dv_bkts.get(_pi) + _lv * _pp)
    else if not _dv_rebuild and _dv_nb > 0 and _dv_step > 0
        float _lh = _vp_d_hi.get(_dv_nb - 1), float _ll = _vp_d_lo.get(_dv_nb - 1), float _lv = _vp_d_vol.get(_dv_nb - 1)
        if _lh > _ll
            int _s = math.max(int(math.floor((_ll - _dv_rlo) / _dv_step)), 0)
            int _e = math.min(int(math.floor((_lh - _dv_rlo) / _dv_step)), i_vp_rows - 1)
            for _pi = _s to _e
                float _pl = _dv_rlo + _pi * _dv_step
                float _pp = switch
                    _ll >= _pl and _lh > _pl + _dv_step  => (_pl + _dv_step - _ll) / (_lh - _ll)
                    _lh <= _pl + _dv_step and _ll < _pl  => (_lh - _pl) / (_lh - _ll)
                    _ll >= _pl and _lh <= _pl + _dv_step => 1.0
                    => _dv_step / (_lh - _ll)
                _dv_bkts.set(_pi, _dv_bkts.get(_pi) + _lv * _pp)
    _dv_poc := na
    _dv_vah := na
    _dv_val := na
    if _dv_bkts.size() == i_vp_rows and _dv_step > 0
        float _mv = _dv_bkts.max()
        if _mv > 0
            int   _pi  = _dv_bkts.indexof(_mv)
            _dv_poc   := _dv_rlo + (_pi + 0.5) * _dv_step
            float _vt  = _dv_bkts.sum() * (i_vp_va_pct / 100.0)
            float _vv  = _mv
            int   _vhi = _pi, int _vli = _pi
            while _vv < _vt
                if _vli == 0 and _vhi == i_vp_rows - 1
                    break
                float _up = _vhi < i_vp_rows - 1 ? _dv_bkts.get(_vhi + 1) : 0.0
                float _dn = _vli > 0              ? _dv_bkts.get(_vli - 1) : 0.0
                if _up == 0.0 and _dn == 0.0
                    break
                if _up >= _dn
                    _vv += _up, _vhi += 1
                else
                    _vv += _dn, _vli -= 1
            _dv_vah := _dv_rlo + (_vhi + 1.0) * _dv_step
            _dv_val := _dv_rlo + _vli         * _dv_step

plot(i_show_vp and i_vp_hist_mode ? _dv_poc : na, "Dev POC", color=i_poc_col,     linewidth=i_poc_width,     style=plot.style_stepline)
plot(i_show_vp and i_vp_hist_mode ? _dv_vah : na, "Dev VAH", color=i_vah_val_col, linewidth=i_vah_val_width, style=plot.style_stepline)
plot(i_show_vp and i_vp_hist_mode ? _dv_val : na, "Dev VAL", color=i_vah_val_col, linewidth=i_vah_val_width, style=plot.style_stepline)

// ═══════════════════════════════════════════════════════════════════════════
// VWAP + STANDARD DEVIATION BANDS  (Welford online variance)
// ═══════════════════════════════════════════════════════════════════════════

var float _cum_tpv  = 0.0
var float _cum_vol  = 0.0
var float _cum_dev2 = 0.0

if is_new_session
    _cum_tpv  := 0.0
    _cum_vol  := 0.0
    _cum_dev2 := 0.0

float tp      = (high + low + close) / 3.0
float _oldvol = _cum_vol
_cum_tpv += tp * volume
_cum_vol += volume

float vwap_val = na
float vwap_sd  = na
if _cum_vol > 0
    vwap_val := _cum_tpv / _cum_vol
    if _oldvol > 0
        float _oldvwap = (_cum_tpv - tp * volume) / _oldvol
        _cum_dev2 += volume * (tp - _oldvwap) * (tp - vwap_val)
    vwap_sd := math.sqrt(math.max(0.0, _cum_dev2 / _cum_vol))

float vwap_p05 = i_show_vwap and i_show_05band ? vwap_val + 0.5 * vwap_sd : na
float vwap_m05 = i_show_vwap and i_show_05band ? vwap_val - 0.5 * vwap_sd : na
float vwap_p2  = i_show_vwap and i_show_2band  ? vwap_val + 2.0 * vwap_sd : na
float vwap_m2  = i_show_vwap and i_show_2band  ? vwap_val - 2.0 * vwap_sd : na
float vwap_p25 = i_show_vwap and i_show_2band  ? vwap_val + 2.5 * vwap_sd : na
float vwap_m25 = i_show_vwap and i_show_2band  ? vwap_val - 2.5 * vwap_sd : na

p_vwap = plot(i_show_vwap ? vwap_val : na, "VWAP",  color=color.yellow,               linewidth=2)
p_p05  = plot(vwap_p05,  "+0.5σ", color=color.new(color.gray, 30), linewidth=1)
p_m05  = plot(vwap_m05,  "−0.5σ", color=color.new(color.gray, 30), linewidth=1)
p_p2   = plot(vwap_p2,   "+2σ",   color=color.new(color.red,  30), linewidth=1)
p_m2   = plot(vwap_m2,   "−2σ",   color=color.new(color.red,  30), linewidth=1)
p_p25  = plot(vwap_p25,  "+2.5σ", color=color.new(color.red,  60), linewidth=1)
p_m25  = plot(vwap_m25,  "−2.5σ", color=color.new(color.red,  60), linewidth=1)
fill(p_p05, p_m05, color=color.new(color.gray, 88), title="0.5σ Fill")

// ═══════════════════════════════════════════════════════════════════════════
// BIG TRADES DETECTOR  (volume intensity z-score, tiered bubbles)
// ═══════════════════════════════════════════════════════════════════════════

float _btd_rng     = high - low
float raw_buy_vol  = _btd_rng == 0 ? 0.0 : (close - low)  / _btd_rng * volume
float raw_sell_vol = _btd_rng == 0 ? 0.0 : (high - close) / _btd_rng * volume

float avg_buy_vol  = ta.sma(raw_buy_vol,    i_btd_lookback)[1]
float std_buy_vol  = ta.stdev(raw_buy_vol,  i_btd_lookback)[1]
float avg_sell_vol = ta.sma(raw_sell_vol,   i_btd_lookback)[1]
float std_sell_vol = ta.stdev(raw_sell_vol, i_btd_lookback)[1]

float thresh_buy  = avg_buy_vol  + std_buy_vol  * i_btd_sigma
float thresh_sell = avg_sell_vol + std_sell_vol * i_btd_sigma

bool is_bt_buy_t1  = raw_buy_vol  > thresh_buy
bool is_bt_buy_t2  = raw_buy_vol  > avg_buy_vol  + std_buy_vol  * (i_btd_sigma + 1.5)
bool is_bt_buy_t3  = raw_buy_vol  > avg_buy_vol  + std_buy_vol  * (i_btd_sigma + 3.0)
bool is_bt_sell_t1 = raw_sell_vol > thresh_sell
bool is_bt_sell_t2 = raw_sell_vol > avg_sell_vol + std_sell_vol * (i_btd_sigma + 1.5)
bool is_bt_sell_t3 = raw_sell_vol > avg_sell_vol + std_sell_vol * (i_btd_sigma + 3.0)

float pos_buy  = math.avg(close, low)
float pos_sell = math.avg(close, high)

plotshape(i_show_btd and is_bt_buy_t1  and not is_bt_buy_t2  ? pos_buy  : na, title="Big Buy (Small)",  style=shape.circle, location=location.absolute, color=i_btd_buy_col,  size=size.small)
plotshape(i_show_btd and is_bt_buy_t2  and not is_bt_buy_t3  ? pos_buy  : na, title="Big Buy (Med)",    style=shape.circle, location=location.absolute, color=i_btd_buy_col,  size=size.normal)
plotshape(i_show_btd and is_bt_buy_t3                         ? pos_buy  : na, title="Big Buy (Large)",  style=shape.circle, location=location.absolute, color=i_btd_buy_col,  size=size.large)
plotshape(i_show_btd and is_bt_sell_t1 and not is_bt_sell_t2 ? pos_sell : na, title="Big Sell (Small)", style=shape.circle, location=location.absolute, color=i_btd_sell_col, size=size.small)
plotshape(i_show_btd and is_bt_sell_t2 and not is_bt_sell_t3 ? pos_sell : na, title="Big Sell (Med)",   style=shape.circle, location=location.absolute, color=i_btd_sell_col, size=size.normal)
plotshape(i_show_btd and is_bt_sell_t3                        ? pos_sell : na, title="Big Sell (Large)", style=shape.circle, location=location.absolute, color=i_btd_sell_col, size=size.large)

// ═══════════════════════════════════════════════════════════════════════════
// MOVING AVERAGE
// ═══════════════════════════════════════════════════════════════════════════

float _ma_val = i_ma_type == "EMA" ? ta.ema(close, i_ma_len) : ta.sma(close, i_ma_len)
plot(i_show_ma ? _ma_val : na, "MA", color=i_ma_col, linewidth=i_ma_width)

// ═══════════════════════════════════════════════════════════════════════════
// SESSIONS  — LuxAlgo bordered-box style with daily divider
// ═══════════════════════════════════════════════════════════════════════════

_tf = timeframe.period

// Numeric 0.0/1.0 session signals (feed into get_range transition logic)
float _s_ndo   = i_show_sess and i_show_ndo   ? math.sign(nz(time(_tf, i_ndo_ses,   i_sess_tz))) : 0.0
float _s_morn  = i_show_sess and i_show_morn  ? math.sign(nz(time(_tf, i_morn_ses,  i_sess_tz))) : 0.0
float _s_lunch = i_show_sess and i_show_lunch ? math.sign(nz(time(_tf, i_lunch_ses, i_sess_tz))) : 0.0
float _s_pwr   = i_show_sess and i_show_pwr   ? math.sign(nz(time(_tf, i_pwr_ses,   i_sess_tz))) : 0.0
float _s_eeod  = i_show_sess and i_show_eeod  ? math.sign(nz(time(_tf, i_eeod_ses,  i_sess_tz))) : 0.0

float _excl_raw    = math.sign(nz(time(_tf, i_excl_ses, i_sess_tz)))
bool  _excl_day_ok = switch i_excl_day
    "Mon"     => dayofweek == dayofweek.monday
    "Tue"     => dayofweek == dayofweek.tuesday
    "Wed"     => dayofweek == dayofweek.wednesday
    "Thu"     => dayofweek == dayofweek.thursday
    "Fri"     => dayofweek == dayofweek.friday
    "Wed/Thu" => dayofweek == dayofweek.wednesday or dayofweek == dayofweek.thursday
    => true
float _s_excl = i_show_sess and i_show_excl ? _excl_raw * (_excl_day_ok ? 1.0 : 0.0) : 0.0

// ── get_range: draw a live bordered box + label per session (LuxAlgo pattern)
// Reads bg_transp / show_outline / show_txt from outer input scope.
get_range(session, session_name, session_css, bstyle = line.style_dotted, lbl_below = false, show_fill = true) =>
    var int   _t   = 0
    var float _hi  = na
    var float _lo  = na
    var box   _bx  = na
    var label _lbl = na
    if session > session[1]
        _t  := time
        _hi := high
        _lo := low
        _bx := box.new(bar_index, _hi, bar_index, _lo,
                   bgcolor      = show_fill ? color.new(session_css, bg_transp) : color.new(color.black, 100),
                   border_color = show_outline ? session_css : na,
                   border_style = bstyle)
        if show_txt
            _lbl := label.new(_t, lbl_below ? _lo : _hi, session_name,
                       xloc      = xloc.bar_time,
                       textcolor = session_css,
                       style     = lbl_below ? label.style_label_up : label.style_label_down,
                       color     = color.new(color.white, 100),
                       size      = size.tiny)
    if session > 0 and session == session[1] and not na(_bx)
        _hi := math.max(high, _hi)
        _lo := math.min(low,  _lo)
        box.set_top(_bx, _hi)
        box.set_rightbottom(_bx, bar_index, _lo)
        if show_txt and not na(_lbl)
            label.set_xy(_lbl, int(math.avg(float(_t), float(time))), lbl_below ? _lo : _hi)

// Draw session boxes (called unconditionally so var state is tracked every bar)
get_range(_s_ndo,   i_ndo_label,   i_ndo_col,  line.style_dotted, false, false)
get_range(_s_morn,  i_morn_label,  i_morn_col, line.style_dotted, false, false)
get_range(_s_lunch, i_lunch_label, i_lunch_col, line.style_dotted, false, false)
get_range(_s_pwr,   i_pwr_label,   i_pwr_col,  line.style_dotted, false, false)
get_range(_s_eeod,  i_eeod_label,  i_eeod_col, line.style_dotted, false, false)
// Exclusion: full-height background (unmissable) + optional bordered box
bgcolor(_s_excl == 1.0 ? color.new(i_excl_col, 80) : na, title="Exclusion Zone")
get_range(_s_excl, i_excl_label, i_excl_col, line.style_solid, true)

// ── Daily Divider: dashed vertical line at 19:00 CT + day label at chart top
if is_new_session and show_day_div
    line.new(bar_index, close + syminfo.mintick, bar_index, close - syminfo.mintick,
             color=color.gray, extend=extend.both, style=line.style_dashed)

plotshape(is_new_session and show_day_div and dayofweek == dayofweek.sunday,    "Sun", shape.labeldown, location.top, color.new(color.white, 100), text="Sunday",    textcolor=color.gray, size=size.small, display=display.all - display.status_line, editable=false)
plotshape(is_new_session and show_day_div and dayofweek == dayofweek.monday,    "Mon", shape.labeldown, location.top, color.new(color.white, 100), text="Monday",    textcolor=color.gray, size=size.small, display=display.all - display.status_line, editable=false)
plotshape(is_new_session and show_day_div and dayofweek == dayofweek.tuesday,   "Tue", shape.labeldown, location.top, color.new(color.white, 100), text="Tuesday",   textcolor=color.gray, size=size.small, display=display.all - display.status_line, editable=false)
plotshape(is_new_session and show_day_div and dayofweek == dayofweek.wednesday, "Wed", shape.labeldown, location.top, color.new(color.white, 100), text="Wednesday", textcolor=color.gray, size=size.small, display=display.all - display.status_line, editable=false)
plotshape(is_new_session and show_day_div and dayofweek == dayofweek.thursday,  "Thu", shape.labeldown, location.top, color.new(color.white, 100), text="Thursday",  textcolor=color.gray, size=size.small, display=display.all - display.status_line, editable=false)
plotshape(is_new_session and show_day_div and dayofweek == dayofweek.friday,    "Fri", shape.labeldown, location.top, color.new(color.white, 100), text="Friday",    textcolor=color.gray, size=size.small, display=display.all - display.status_line, editable=false)
plotshape(is_new_session and show_day_div and dayofweek == dayofweek.saturday,  "Sat", shape.labeldown, location.top, color.new(color.white, 100), text="Saturday",  textcolor=color.gray, size=size.small, display=display.all - display.status_line, editable=false)

// ═══════════════════════════════════════════════════════════════════════════
// EXPECTED RANGE  — IV-implied daily move applied to 19:00 CT session open
// Formula: daily_move = DVOL / sqrt(365) / 100
//          Upper = session_open × (1 + daily_move)
//          Lower = session_open × (1 - daily_move)
// ═══════════════════════════════════════════════════════════════════════════

float _er_iv_sym_val = request.security(i_er_iv_sym, "D", close)
float _er_iv    = i_asset_mode == "Equities" ? i_er_iv_manual : _er_iv_sym_val
float _er_daily = not na(_er_iv) and _er_iv > 0 ? _er_iv / math.sqrt(365) / 100 : na

var float _er_open      = na
var int   _er_x1        = 0
var line  _er_uline     = na
var line  _er_lline     = na
var line  _er_u150line  = na
var line  _er_l150line  = na
var box   _er_ubox      = na
var box   _er_lbox      = na
var label _er_ulbl      = na
var label _er_llbl      = na
var label _er_u150lbl   = na
var label _er_l150lbl   = na
var line  _er_u20line   = na
var line  _er_u40line   = na
var line  _er_u60line   = na
var line  _er_u80line   = na
var line  _er_l20line   = na
var line  _er_l40line   = na
var line  _er_l60line   = na
var line  _er_l80line   = na
var box   _er_u40box    = na
var box   _er_l40box    = na
var box   _er_u80box    = na
var box   _er_l80box    = na
var label _er_u20lbl    = na
var label _er_u40lbl    = na
var label _er_u60lbl    = na
var label _er_u80lbl    = na
var label _er_l20lbl    = na
var label _er_l40lbl    = na
var label _er_l60lbl    = na
var label _er_l80lbl    = na

// ── Initialise new session objects at 19:00 CT ────────────────────────────

if is_new_session and i_show_er and not na(_er_daily)
    _er_open := i_asset_mode == "Equities" ? close : open
    _er_x1   := bar_index

    float _dist   = _er_open * _er_daily
    float _up     = _er_open + _dist
    float _dn     = _er_open - _dist
    float _up_150 = _er_open + _dist * 1.5
    float _dn_150 = _er_open - _dist * 1.5
    float _up_20  = _er_open + _dist * 0.2
    float _up_40  = _er_open + _dist * 0.4
    float _up_60  = _er_open + _dist * 0.6
    float _up_80  = _er_open + _dist * 0.8
    float _dn_20  = _er_open - _dist * 0.2
    float _dn_40  = _er_open - _dist * 0.4
    float _dn_60  = _er_open - _dist * 0.6
    float _dn_80  = _er_open - _dist * 0.8
    float _pct    = math.floor(_er_iv / math.sqrt(365) * 100) / 100

    _er_uline    := line.new(_er_x1, _up, _er_x1, _up,
                              color=color.lime, width=3, style=line.style_solid)
    _er_lline    := line.new(_er_x1, _dn, _er_x1, _dn,
                              color=color.red,  width=3, style=line.style_solid)
    _er_u150line := line.new(_er_x1, _up_150, _er_x1, _up_150,
                              color=color.purple, width=3, style=line.style_solid)
    _er_l150line := line.new(_er_x1, _dn_150, _er_x1, _dn_150,
                              color=color.purple, width=3, style=line.style_solid)
    _er_u150lbl  := label.new(_er_x1, _up_150, " 150% - Volatility Hard Stop (" + str.tostring(_up_150, format.mintick) + ")",
                               textcolor=color.purple, style=label.style_label_left,
                               color=color.new(color.black, 100), size=size.small)
    _er_l150lbl  := label.new(_er_x1, _dn_150, " 150% - Volatility Hard Stop (" + str.tostring(_dn_150, format.mintick) + ")",
                               textcolor=color.purple, style=label.style_label_left,
                               color=color.new(color.black, 100), size=size.small)
    // Outer zones (0–40% and 80–100%): light fill
    _er_ubox    := box.new(_er_x1, _up_40, _er_x1, _er_open,
                            bgcolor=color.new(color.lime, 88), border_color=na)
    _er_lbox    := box.new(_er_x1, _er_open, _er_x1, _dn_40,
                            bgcolor=color.new(color.red,  88), border_color=na)
    _er_u80box  := box.new(_er_x1, _up, _er_x1, _up_80,
                            bgcolor=color.new(color.lime, 88), border_color=na)
    _er_l80box  := box.new(_er_x1, _dn_80, _er_x1, _dn,
                            bgcolor=color.new(color.red,  88), border_color=na)
    // Middle zone (40–80%): deeper fill
    _er_u40box  := box.new(_er_x1, _up_80, _er_x1, _up_40,
                            bgcolor=color.new(color.lime, 70), border_color=na)
    _er_l40box  := box.new(_er_x1, _dn_40, _er_x1, _dn_80,
                            bgcolor=color.new(color.red,  70), border_color=na)
    // Intermediate dashed lines at 20%, 40%, 60%, 80%
    _er_u20line := line.new(_er_x1, _up_20, _er_x1, _up_20,
                             color=color.new(color.lime, 40), width=1, style=line.style_dashed)
    _er_u40line := line.new(_er_x1, _up_40, _er_x1, _up_40,
                             color=color.new(color.lime, 40), width=1, style=line.style_dashed)
    _er_u60line := line.new(_er_x1, _up_60, _er_x1, _up_60,
                             color=color.new(color.lime, 40), width=1, style=line.style_dashed)
    _er_u80line := line.new(_er_x1, _up_80, _er_x1, _up_80,
                             color=color.new(color.lime, 40), width=1, style=line.style_dashed)
    _er_l20line := line.new(_er_x1, _dn_20, _er_x1, _dn_20,
                             color=color.new(color.red,  40), width=1, style=line.style_dashed)
    _er_l40line := line.new(_er_x1, _dn_40, _er_x1, _dn_40,
                             color=color.new(color.red,  40), width=1, style=line.style_dashed)
    _er_l60line := line.new(_er_x1, _dn_60, _er_x1, _dn_60,
                             color=color.new(color.red,  40), width=1, style=line.style_dashed)
    _er_l80line := line.new(_er_x1, _dn_80, _er_x1, _dn_80,
                             color=color.new(color.red,  40), width=1, style=line.style_dashed)
    // Intermediate labels — label_left keeps text horizontally aligned with each line
    _er_u20lbl  := label.new(_er_x1, _up_20, " 20%",
                              textcolor=color.lime, style=label.style_label_left,
                              color=color.new(color.black, 100), size=size.tiny)
    _er_u40lbl  := label.new(_er_x1, _up_40, " 40% (" + str.tostring(_up_40, format.mintick) + ")",
                              textcolor=color.lime, style=label.style_label_left,
                              color=color.new(color.black, 100), size=size.tiny)
    _er_u60lbl  := label.new(_er_x1, _up_60, " 60%",
                              textcolor=color.lime, style=label.style_label_left,
                              color=color.new(color.black, 100), size=size.tiny)
    _er_u80lbl  := label.new(_er_x1, _up_80, " 80% (" + str.tostring(_up_80, format.mintick) + ")",
                              textcolor=color.lime, style=label.style_label_left,
                              color=color.new(color.black, 100), size=size.tiny)
    _er_l20lbl  := label.new(_er_x1, _dn_20, " 20%",
                              textcolor=color.red, style=label.style_label_left,
                              color=color.new(color.black, 100), size=size.tiny)
    _er_l40lbl  := label.new(_er_x1, _dn_40, " 40% (" + str.tostring(_dn_40, format.mintick) + ")",
                              textcolor=color.red, style=label.style_label_left,
                              color=color.new(color.black, 100), size=size.tiny)
    _er_l60lbl  := label.new(_er_x1, _dn_60, " 60%",
                              textcolor=color.red, style=label.style_label_left,
                              color=color.new(color.black, 100), size=size.tiny)
    _er_l80lbl  := label.new(_er_x1, _dn_80, " 80% (" + str.tostring(_dn_80, format.mintick) + ")",
                              textcolor=color.red, style=label.style_label_left,
                              color=color.new(color.black, 100), size=size.tiny)
    _er_ulbl    := label.new(_er_x1, _up,
                              " Upper Bound: +" + str.tostring(_pct, "#.##") + "% (" + str.tostring(_up, format.mintick) + ")",
                              textcolor=color.lime, style=label.style_label_left,
                              color=color.new(color.black, 100), size=size.small)
    _er_llbl    := label.new(_er_x1, _dn,
                              " Lower Bound: -" + str.tostring(_pct, "#.##") + "% (" + str.tostring(_dn, format.mintick) + ")",
                              textcolor=color.red,  style=label.style_label_left,
                              color=color.new(color.black, 100), size=size.small)

// ── Update live: extend lines/boxes, refresh label text + position ────────

if i_show_er and not na(_er_open) and not na(_er_daily) and not is_new_session
    float _dist   = _er_open * _er_daily
    float _up     = _er_open + _dist
    float _dn     = _er_open - _dist
    float _up_150 = _er_open + _dist * 1.5
    float _dn_150 = _er_open - _dist * 1.5
    float _up_20  = _er_open + _dist * 0.2
    float _up_40  = _er_open + _dist * 0.4
    float _up_60  = _er_open + _dist * 0.6
    float _up_80  = _er_open + _dist * 0.8
    float _dn_20  = _er_open - _dist * 0.2
    float _dn_40  = _er_open - _dist * 0.4
    float _dn_60  = _er_open - _dist * 0.6
    float _dn_80  = _er_open - _dist * 0.8
    float _pct    = math.floor(_er_iv / math.sqrt(365) * 100) / 100

    if not na(_er_uline)
        line.set_y1(_er_uline, _up)
        line.set_y2(_er_uline, _up)
        line.set_x2(_er_uline, bar_index)
    if not na(_er_lline)
        line.set_y1(_er_lline, _dn)
        line.set_y2(_er_lline, _dn)
        line.set_x2(_er_lline, bar_index)
    if not na(_er_u150line)
        line.set_y1(_er_u150line, _up_150)
        line.set_y2(_er_u150line, _up_150)
        line.set_x2(_er_u150line, bar_index)
    if not na(_er_l150line)
        line.set_y1(_er_l150line, _dn_150)
        line.set_y2(_er_l150line, _dn_150)
        line.set_x2(_er_l150line, bar_index)
    if not na(_er_u150lbl)
        label.set_xy(_er_u150lbl, bar_index, _up_150)
        label.set_text(_er_u150lbl, " 150% - Volatility Hard Stop (" + str.tostring(_up_150, format.mintick) + ")")
    if not na(_er_l150lbl)
        label.set_xy(_er_l150lbl, bar_index, _dn_150)
        label.set_text(_er_l150lbl, " 150% - Volatility Hard Stop (" + str.tostring(_dn_150, format.mintick) + ")")
    if not na(_er_ubox)
        box.set_top(_er_ubox,    _up_40)
        box.set_bottom(_er_ubox, _er_open)
        box.set_right(_er_ubox,  bar_index)
    if not na(_er_lbox)
        box.set_top(_er_lbox,    _er_open)
        box.set_bottom(_er_lbox, _dn_40)
        box.set_right(_er_lbox,  bar_index)
    if not na(_er_u80box)
        box.set_top(_er_u80box,    _up)
        box.set_bottom(_er_u80box, _up_80)
        box.set_right(_er_u80box,  bar_index)
    if not na(_er_l80box)
        box.set_top(_er_l80box,    _dn_80)
        box.set_bottom(_er_l80box, _dn)
        box.set_right(_er_l80box,  bar_index)
    if not na(_er_u40box)
        box.set_top(_er_u40box,    _up_80)
        box.set_bottom(_er_u40box, _up_40)
        box.set_right(_er_u40box,  bar_index)
    if not na(_er_l40box)
        box.set_top(_er_l40box,    _dn_40)
        box.set_bottom(_er_l40box, _dn_80)
        box.set_right(_er_l40box,  bar_index)
    if not na(_er_u20line)
        line.set_y1(_er_u20line, _up_20)
        line.set_y2(_er_u20line, _up_20)
        line.set_x2(_er_u20line, bar_index)
    if not na(_er_u40line)
        line.set_y1(_er_u40line, _up_40)
        line.set_y2(_er_u40line, _up_40)
        line.set_x2(_er_u40line, bar_index)
    if not na(_er_u60line)
        line.set_y1(_er_u60line, _up_60)
        line.set_y2(_er_u60line, _up_60)
        line.set_x2(_er_u60line, bar_index)
    if not na(_er_u80line)
        line.set_y1(_er_u80line, _up_80)
        line.set_y2(_er_u80line, _up_80)
        line.set_x2(_er_u80line, bar_index)
    if not na(_er_l20line)
        line.set_y1(_er_l20line, _dn_20)
        line.set_y2(_er_l20line, _dn_20)
        line.set_x2(_er_l20line, bar_index)
    if not na(_er_l40line)
        line.set_y1(_er_l40line, _dn_40)
        line.set_y2(_er_l40line, _dn_40)
        line.set_x2(_er_l40line, bar_index)
    if not na(_er_l60line)
        line.set_y1(_er_l60line, _dn_60)
        line.set_y2(_er_l60line, _dn_60)
        line.set_x2(_er_l60line, bar_index)
    if not na(_er_l80line)
        line.set_y1(_er_l80line, _dn_80)
        line.set_y2(_er_l80line, _dn_80)
        line.set_x2(_er_l80line, bar_index)
    if not na(_er_u20lbl)
        label.set_xy(_er_u20lbl, bar_index, _up_20)
    if not na(_er_u40lbl)
        label.set_xy(_er_u40lbl, bar_index, _up_40)
        label.set_text(_er_u40lbl, " 40% (" + str.tostring(_up_40, format.mintick) + ")")
    if not na(_er_u60lbl)
        label.set_xy(_er_u60lbl, bar_index, _up_60)
    if not na(_er_u80lbl)
        label.set_xy(_er_u80lbl, bar_index, _up_80)
        label.set_text(_er_u80lbl, " 80% (" + str.tostring(_up_80, format.mintick) + ")")
    if not na(_er_l20lbl)
        label.set_xy(_er_l20lbl, bar_index, _dn_20)
    if not na(_er_l40lbl)
        label.set_xy(_er_l40lbl, bar_index, _dn_40)
        label.set_text(_er_l40lbl, " 40% (" + str.tostring(_dn_40, format.mintick) + ")")
    if not na(_er_l60lbl)
        label.set_xy(_er_l60lbl, bar_index, _dn_60)
    if not na(_er_l80lbl)
        label.set_xy(_er_l80lbl, bar_index, _dn_80)
        label.set_text(_er_l80lbl, " 80% (" + str.tostring(_dn_80, format.mintick) + ")")
    if not na(_er_ulbl)
        label.set_xy(_er_ulbl, bar_index, _up)
        label.set_text(_er_ulbl, " Upper Bound: +" + str.tostring(_pct, "#.##") + "% (" + str.tostring(_up, format.mintick) + ")")
    if not na(_er_llbl)
        label.set_xy(_er_llbl, bar_index, _dn)
        label.set_text(_er_llbl, " Lower Bound: -" + str.tostring(_pct, "#.##") + "% (" + str.tostring(_dn, format.mintick) + ")")

// ── DVOL Dashboard ────────────────────────────────────────────────────────

var table _dvol_tb = table.new(position.bottom_right, 3, 1,
     bgcolor=#1e222d, border_color=#373a46, border_width=1,
     frame_color=#373a46, frame_width=1)

if barstate.islast and i_show_dvol_db
    string _sym_lbl  = i_asset_mode == "Equities" ? "Manual IV" : str.replace(i_er_iv_sym, "DERIBIT:", "")
    string _iv_str   = not na(_er_iv) ? str.tostring(_er_iv, "#.##") : "N/A"
    color  _iv_color = not na(_er_iv) ?
         _er_iv < 50  ? color.green  :
         _er_iv < 70  ? color.yellow :
         _er_iv < 90  ? color.orange : color.red
         : color.gray
    string _state    = not na(_er_iv) ?
         _er_iv < 50  ? "Full Progression" :
         _er_iv < 70  ? "3R Cap"           :
         _er_iv < 90  ? "5R Cap"           : "1R or None"
         : "N/A"
    table.cell(_dvol_tb, 0, 0, _sym_lbl, text_color=color.gray, text_size=size.small, bgcolor=#1e222d)
    table.cell(_dvol_tb, 1, 0, _iv_str,  text_color=_iv_color,  text_size=size.small, bgcolor=#1e222d)
    table.cell(_dvol_tb, 2, 0, _state,   text_color=_iv_color,  text_size=size.small, bgcolor=#1e222d)

// ═══════════════════════════════════════════════════════════════════════════
// SESSION OPEN LINE — dashed white line at 19:00 CT candle open
// ═══════════════════════════════════════════════════════════════════════════

var float _so_price = na
var line  _so_line  = na
var label _so_lbl   = na

if is_new_session and i_show_so
    _so_price := i_asset_mode == "Equities" ? close : open
    string _so_txt = i_asset_mode == "Equities" ? "Previous EOD Close: " + str.tostring(_so_price, format.mintick) : "Session Open"
    _so_line  := line.new(bar_index, _so_price, bar_index + 1, _so_price,
                          color=color.white, style=line.style_dashed, width=1)
    _so_lbl   := label.new(bar_index, _so_price, _so_txt,
                           textcolor=color.white, style=label.style_label_left,
                           color=color.new(color.black, 100), size=size.small)

if i_show_so and not na(_so_line) and not is_new_session
    line.set_x2(_so_line, bar_index)
    label.set_xy(_so_lbl, bar_index, _so_price)

// ═══════════════════════════════════════════════════════════════════════════
// VOLUME PROFILE
// ═══════════════════════════════════════════════════════════════════════════

f_vp_render_boxes(VPSession s, bool place_right, int pw, int offset) =>
    float _mv = s.vols.max()
    if _mv > 0
        for _ri = 0 to s.vols.size() - 1
            float _rv   = s.vols.get(_ri)
            float _rpct = _rv / _mv
            float _rlo2 = s.rlo + _ri       * s.step_sz
            float _rhi2 = s.rlo + (_ri + 1) * s.step_sz
            bool  _inva = _ri >= s.val_i and _ri <= s.vah_i
            color _col  = color.new(color.white, 100)
            if _inva
                _col := color.from_gradient(_rpct, 0, 1, color.new(#2962ff, 72), color.new(#2962ff, 15))
            else
                _col := color.from_gradient(_rpct, 0, 1, color.new(#5d606b, 80), color.new(#5d606b, 40))
            int _bx1 = 0, _bx2 = 0
            if place_right
                _bx2 := bar_index + offset + pw
                _bx1 := _bx2 - int(_rpct * pw)
            else
                _bx2 := s.end_bi
                _bx1 := math.max(_bx2 - int(_rpct * pw), bar_index - 4900)
            _vp_boxes.push(box.new(_bx1, _rhi2, _bx2, _rlo2, border_color=na, bgcolor=_col))

if barstate.islast and i_show_vp
    // ── Clear all previous drawings ───────────────────────────────────────
    if _vp_boxes.size() > 0
        for _ci = 0 to _vp_boxes.size() - 1
            box.delete(_vp_boxes.get(_ci))
        _vp_boxes.clear()
    if _vp_poc_lns.size() > 0
        for _ci = 0 to _vp_poc_lns.size() - 1
            line.delete(_vp_poc_lns.get(_ci))
            line.delete(_vp_vah_lns.get(_ci))
            line.delete(_vp_val_lns.get(_ci))
        _vp_poc_lns.clear()
        _vp_vah_lns.clear()
        _vp_val_lns.clear()
    label.delete(_vp_poc_lbl)
    label.delete(_vp_vah_lbl)
    label.delete(_vp_val_lbl)

    if i_vp_period == "Day"
        // ── Compute current (live) session profile ────────────────────────
        VPSession _cur = f_vp_compute(_vp_d_hi, _vp_d_lo, _vp_d_vol,
                                       _vp_d_start, bar_index,
                                       i_vp_rows, i_vp_va_pct)

        // ── Build the render list: history + current ──────────────────────
        // Box budget: leave 40 for session/ER boxes
        int _max_sess  = math.max(460 / math.max(i_vp_rows, 1), 1)
        int _n_hist    = _vp_hist.size()
        int _first     = math.max(_n_hist - (_max_sess - 1), 0)

        bool _cur_right = i_vp_placement == "Right"
        int  _pw        = i_vp_width

        // Render historical sessions (right-anchored to session end)
        if _n_hist > 0
            for _si = _first to _n_hist - 1
                VPSession _s = _vp_hist.get(_si)
                if bar_index - _s.end_bi > 4900
                    continue
                f_vp_render_boxes(_s, false, _pw, i_vp_offset)
                int _lx2 = _s.end_bi
                int _lx1 = math.max(_s.start_bi, bar_index - 4900)
                if i_show_poc and not i_vp_hist_mode
                    _vp_poc_lns.push(line.new(_lx1, _s.poc_p, _lx2, _s.poc_p,
                                               color=i_poc_col, width=i_poc_width))
                if i_show_vah_val and not i_vp_hist_mode
                    _vp_vah_lns.push(line.new(_lx1, _s.vah_p, _lx2, _s.vah_p,
                                               color=i_vah_val_col, width=i_vah_val_width))
                    _vp_val_lns.push(line.new(_lx1, _s.val_p, _lx2, _s.val_p,
                                               color=i_vah_val_col, width=i_vah_val_width))

        // Render current session
        f_vp_render_boxes(_cur, _cur_right, _pw, i_vp_offset)
        int _cur_lx2 = _cur_right ? bar_index + i_vp_offset + _pw : bar_index
        if i_show_poc
            if not i_vp_hist_mode
                _vp_poc_lns.push(line.new(_cur.start_bi, _cur.poc_p, _cur_lx2, _cur.poc_p,
                                           color=i_poc_col, width=i_poc_width))
            _vp_poc_lbl := label.new(_cur_lx2, _cur.poc_p,
                                     " POC: " + str.tostring(_cur.poc_p, format.mintick),
                                     textcolor=i_poc_col, style=label.style_label_left,
                                     color=color.new(color.black, 100), size=size.tiny)
        if i_show_vah_val
            if not i_vp_hist_mode
                _vp_vah_lns.push(line.new(_cur.start_bi, _cur.vah_p, _cur_lx2, _cur.vah_p,
                                           color=i_vah_val_col, width=i_vah_val_width))
            _vp_vah_lbl := label.new(_cur_lx2, _cur.vah_p,
                                     " VAH: " + str.tostring(_cur.vah_p, format.mintick),
                                     textcolor=i_vah_val_col, style=label.style_label_left,
                                     color=color.new(color.black, 100), size=size.tiny)
            if not i_vp_hist_mode
                _vp_val_lns.push(line.new(_cur.start_bi, _cur.val_p, _cur_lx2, _cur.val_p,
                                           color=i_vah_val_col, width=i_vah_val_width))
            _vp_val_lbl := label.new(_cur_lx2, _cur.val_p,
                                     " VAL: " + str.tostring(_cur.val_p, format.mintick),
                                     textcolor=i_vah_val_col, style=label.style_label_left,
                                     color=color.new(color.black, 100), size=size.tiny)

    else  // Custom period — single profile from lookback
        int _len = math.min(i_vp_length, bar_index + 1)
        float[] _bh = array.new_float(_len)
        float[] _bl = array.new_float(_len)
        float[] _bv = array.new_float(_len)
        for _i = 0 to _len - 1
            _bh.set(_i, high[_len - 1 - _i])
            _bl.set(_i, low[_len - 1 - _i])
            _bv.set(_i, volume[_len - 1 - _i])
        VPSession _c = f_vp_compute(_bh, _bl, _bv,
                                     bar_index - _len + 1, bar_index,
                                     i_vp_rows, i_vp_va_pct)
        bool _pr  = i_vp_placement == "Right"
        int  _lx2 = _pr ? bar_index + i_vp_offset + i_vp_width : bar_index
        f_vp_render_boxes(_c, _pr, i_vp_width, i_vp_offset)
        if i_show_poc
            _vp_poc_lns.push(line.new(_c.start_bi, _c.poc_p, _lx2, _c.poc_p,
                                       color=i_poc_col, width=i_poc_width))
            _vp_poc_lbl := label.new(bar_index, _c.poc_p,
                                     " POC: " + str.tostring(_c.poc_p, format.mintick),
                                     textcolor=i_poc_col, style=label.style_label_left,
                                     color=color.new(color.black, 100), size=size.tiny)
        if i_show_vah_val
            _vp_vah_lns.push(line.new(_c.start_bi, _c.vah_p, _lx2, _c.vah_p,
                                       color=i_vah_val_col, width=i_vah_val_width))
            _vp_vah_lbl := label.new(bar_index, _c.vah_p,
                                     " VAH: " + str.tostring(_c.vah_p, format.mintick),
                                     textcolor=i_vah_val_col, style=label.style_label_left,
                                     color=color.new(color.black, 100), size=size.tiny)
            _vp_val_lns.push(line.new(_c.start_bi, _c.val_p, _lx2, _c.val_p,
                                       color=i_vah_val_col, width=i_vah_val_width))
            _vp_val_lbl := label.new(bar_index, _c.val_p,
                                     " VAL: " + str.tostring(_c.val_p, format.mintick),
                                     textcolor=i_vah_val_col, style=label.style_label_left,
                                     color=color.new(color.black, 100), size=size.tiny)

// ═══════════════════════════════════════════════════════════════════════════
// USER LEVELS — Buy Territory / Sell Territory
// ═══════════════════════════════════════════════════════════════════════════

var line  _buy_line  = na
var label _buy_lbl   = na
var line  _sell_line = na
var label _sell_lbl  = na

if barstate.islast
    line.delete(_buy_line)
    label.delete(_buy_lbl)
    line.delete(_sell_line)
    label.delete(_sell_lbl)
    _buy_line  := i_show_buy_lvl  and i_buy_lvl  != 0 ? line.new(bar_index, i_buy_lvl,  bar_index - 1, i_buy_lvl,  color=color.white, style=line.style_dotted, width=1, extend=extend.both) : na
    _buy_lbl   := i_show_buy_lvl  and i_buy_lvl  != 0 ? label.new(bar_index, i_buy_lvl,  "Buy Territory",  textcolor=color.white, style=label.style_label_left, color=color.new(color.black, 100), size=size.small) : na
    _sell_line := i_show_sell_lvl and i_sell_lvl != 0 ? line.new(bar_index, i_sell_lvl, bar_index - 1, i_sell_lvl, color=color.white, style=line.style_dotted, width=1, extend=extend.both) : na
    _sell_lbl  := i_show_sell_lvl and i_sell_lvl != 0 ? label.new(bar_index, i_sell_lvl, "Sell Territory", textcolor=color.white, style=label.style_label_left, color=color.new(color.black, 100), size=size.small) : na

// ═══════════════════════════════════════════════════════════════════════════
// ALERTS — set up via TradingView's "Create Alert" dialog; pick any condition
// ═══════════════════════════════════════════════════════════════════════════

float _al_dist   = not na(_er_open) and not na(_er_daily) ? _er_open * _er_daily : na
float _al_er_u40  = not na(_al_dist) ? _er_open + _al_dist * 0.4 : na
float _al_er_d40  = not na(_al_dist) ? _er_open - _al_dist * 0.4 : na
float _al_er_u80  = not na(_al_dist) ? _er_open + _al_dist * 0.8 : na
float _al_er_d80  = not na(_al_dist) ? _er_open - _al_dist * 0.8 : na
float _al_er_u100 = not na(_al_dist) ? _er_open + _al_dist       : na
float _al_er_d100 = not na(_al_dist) ? _er_open - _al_dist       : na
float _al_er_u150 = not na(_al_dist) ? _er_open + _al_dist * 1.5 : na
float _al_er_d150 = not na(_al_dist) ? _er_open - _al_dist * 1.5 : na

bool _al_cross40  = i_show_er and not na(_al_dist) and
     (ta.crossover(close, _al_er_u40)  or ta.crossunder(close, _al_er_u40)  or
      ta.crossover(close, _al_er_d40)  or ta.crossunder(close, _al_er_d40))
bool _al_cross80  = i_show_er and not na(_al_dist) and
     (ta.crossover(close, _al_er_u80)  or ta.crossunder(close, _al_er_u80)  or
      ta.crossover(close, _al_er_d80)  or ta.crossunder(close, _al_er_d80))
bool _al_cross100 = i_show_er and not na(_al_dist) and
     (ta.crossover(close, _al_er_u100) or ta.crossunder(close, _al_er_u100) or
      ta.crossover(close, _al_er_d100) or ta.crossunder(close, _al_er_d100))
bool _al_cross150 = i_show_er and not na(_al_dist) and
     (ta.crossover(close, _al_er_u150) or ta.crossunder(close, _al_er_u150) or
      ta.crossover(close, _al_er_d150) or ta.crossunder(close, _al_er_d150))
bool _al_poc      = i_show_vp and not na(_dv_poc) and
     (ta.crossover(close, _dv_poc) or ta.crossunder(close, _dv_poc))
bool _al_vah      = i_show_vp and not na(_dv_vah) and
     (ta.crossover(close, _dv_vah) or ta.crossunder(close, _dv_vah))
bool _al_val      = i_show_vp and not na(_dv_val) and
     (ta.crossover(close, _dv_val) or ta.crossunder(close, _dv_val))
bool _al_bt_buy   = i_show_btd and is_bt_buy_t1
bool _al_bt_sell  = i_show_btd and is_bt_sell_t1

alertcondition(_al_cross40,  title="Alert: ER 40% Cross",   message="Price crossed ER 40% level")
alertcondition(_al_cross80,  title="Alert: ER 80% Cross",   message="Price crossed ER 80% level")
alertcondition(_al_cross100, title="Alert: ER 100% Cross",  message="Price crossed ER 100% (Upper/Lower Bound)")
alertcondition(_al_cross150, title="Alert: ER 150% Cross",  message="Price crossed ER 150% Volatility Hard Stop")
alertcondition(_al_poc,      title="Alert: VP POC Cross",   message="Price crossed VP Point of Control")
alertcondition(_al_vah,      title="Alert: VP VAH Cross",   message="Price crossed VP Value Area High")
alertcondition(_al_val,      title="Alert: VP VAL Cross",   message="Price crossed VP Value Area Low")
alertcondition(_al_bt_buy,   title="Alert: Big Buy Trade",  message="Big Buy Trade detected (candle close)")
alertcondition(_al_bt_sell,  title="Alert: Big Sell Trade", message="Big Sell Trade detected (candle close)")

// Auto-fire alerts — require only one "Any alert() function call" alert in TradingView
if i_alerts_on and barstate.isconfirmed
    if i_al_er_40  and _al_cross40
        alert(syminfo.ticker + " ▸ ER 40% Cross — close " + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)
    if i_al_er_80  and _al_cross80
        alert(syminfo.ticker + " ▸ ER 80% Cross — close " + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)
    if i_al_er_100 and _al_cross100
        alert(syminfo.ticker + " ▸ ER 100% Cross — close " + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)
    if i_al_er_150 and _al_cross150
        alert(syminfo.ticker + " ▸ ER 150% Hard Stop Cross — close " + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)
    if i_al_vp_poc and _al_poc
        alert(syminfo.ticker + " ▸ VP POC Cross — close " + str.tostring(close, format.mintick) + "  POC " + str.tostring(_dv_poc, format.mintick), alert.freq_once_per_bar_close)
    if i_al_vp_vah and _al_vah
        alert(syminfo.ticker + " ▸ VP VAH Cross — close " + str.tostring(close, format.mintick) + "  VAH " + str.tostring(_dv_vah, format.mintick), alert.freq_once_per_bar_close)
    if i_al_vp_val and _al_val
        alert(syminfo.ticker + " ▸ VP VAL Cross — close " + str.tostring(close, format.mintick) + "  VAL " + str.tostring(_dv_val, format.mintick), alert.freq_once_per_bar_close)
    if i_al_bt_buy  and _al_bt_buy
        alert(syminfo.ticker + " ▸ Big Buy Trade — close " + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)
    if i_al_bt_sell and _al_bt_sell
        alert(syminfo.ticker + " ▸ Big Sell Trade — close " + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)
