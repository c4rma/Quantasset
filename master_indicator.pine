//@version=6
indicator("ChartHacker", overlay=true,
          max_bars_back=500, max_lines_count=500,
          max_boxes_count=500, max_labels_count=500)

// ═══════════════════════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════════════════════

// ── GENERAL ───────────────────────────────────────────────────────────────
i_asset_mode = input.string("Crypto", "Asset Mode", group="General",
                 options=["Crypto", "Equities"],
                 tooltip="Crypto: new day at 19:00 CT (CME futures open), anchored to candle open.\nEquities: new day at 16:00 CT (market close), anchored to candle close.")

// ── VWAP ──────────────────────────────────────────────────────────────────
i_show_vwap   = input.bool(true,  "Show VWAP",         group="VWAP")
i_show_05band = input.bool(true,  "Show ±0.5σ Band",   group="VWAP")
i_show_2band  = input.bool(true,  "Show ±2σ / ±2.5σ", group="VWAP")

// ── BIG TRADES ────────────────────────────────────────────────────────────
i_show_btd     = input.bool(true,  "Show Big Trades Detector", group="Big Trades (Whale) Settings")
i_btd_lookback = input.int(2,      "Lookback Period",          group="Big Trades (Whale) Settings", minval=2)
i_btd_sigma    = input.float(3.0,  "Sensitivity (Sigma)",      group="Big Trades (Whale) Settings", minval=1.0, step=0.1, tooltip="2.0 = Significant, 4.0 = Extreme.")
i_btd_buy_col  = input.color(color.new(color.lime, 20), "Big Buy Color",  group="Big Trades (Whale) Settings")
i_btd_sell_col = input.color(color.new(color.red,  20), "Big Sell Color", group="Big Trades (Whale) Settings")

// ── MOVING AVERAGE ────────────────────────────────────────────────────────
i_show_ma  = input.bool(true,    "Show MA",   group="Moving Average")
i_ma_type  = input.string("EMA", "Type",      group="Moving Average", options=["SMA", "EMA"])
i_ma_len   = input.int(20,       "Length",    group="Moving Average", minval=1)
i_ma_col   = input.color(color.new(color.white, 0), "Color", group="Moving Average")
i_ma_width = input.int(1,        "Thickness", group="Moving Average", minval=1, maxval=5)

// ── LEVELS ────────────────────────────────────────────────────────────────
i_show_buy_lvl  = input.bool(true, "", inline="buylvl",  group="Levels")
i_buy_lvl       = input.price(0.0, "Buy Territory",  inline="buylvl",  group="Levels")
i_show_sell_lvl = input.bool(true, "", inline="selllvl", group="Levels")
i_sell_lvl      = input.price(0.0, "Sell Territory", inline="selllvl", group="Levels")

// ── EXPECTED RANGE ────────────────────────────────────────────────────────
i_show_er      = input.bool(true,           "Show Expected Range",    group="Expected Range")
i_er_iv_sym    = input.symbol("DERIBIT:ETHDVOL", "IV Symbol (DVOL)", group="Expected Range", tooltip="Used in Crypto mode.")
i_er_iv_manual = input.float(50.0,          "Manual IV (%)",          group="Expected Range", minval=1.0, maxval=999.0, step=0.5, tooltip="Annual implied volatility in percent (e.g. 50 = 50%). Used in Equities mode.")
i_show_dvol_db = input.bool(true,           "Show DVOL Dashboard",   group="Expected Range")

// ── SESSIONS ──────────────────────────────────────────────────────────────
i_show_sess   = input.bool(true,                 "Show Sessions",          group="Sessions")
i_sess_tz     = input.string("America/Chicago",  "Timezone",               group="Sessions")
bg_transp     = input.float(85.0,                "Range Transparency",     group="Sessions", minval=0, maxval=100)
show_outline  = input.bool(true,                 "Range Outline",          group="Sessions")
show_txt      = input.bool(true,                 "Range Label",            group="Sessions")
show_day_div  = input.bool(true,                 "Show Daily Divider",     group="Sessions")
i_show_so     = input.bool(true,                 "Show Session Open Line", group="Sessions")

i_show_ndo    = input.bool(true,  "", inline="ndo",   group="Sessions")
i_ndo_label   = input.string("NDO",        "", inline="ndo",   group="Sessions")
i_ndo_ses     = input.session("0000-0330", "", inline="ndo",   group="Sessions")
i_ndo_col     = input.color(color.new(color.blue,    80), "", inline="ndo",   group="Sessions")

i_show_morn   = input.bool(true,  "", inline="morn",  group="Sessions")
i_morn_label  = input.string("Morning",    "", inline="morn",  group="Sessions")
i_morn_ses    = input.session("0830-1030", "", inline="morn",  group="Sessions")
i_morn_col    = input.color(color.new(color.aqua,    80), "", inline="morn",  group="Sessions")

i_show_excl   = input.bool(true,  "", inline="excl",  group="Sessions")
i_excl_label  = input.string("Exclusion", "", inline="excl",  group="Sessions")
i_excl_ses    = input.session("0900-1000", "", inline="excl",  group="Sessions")
i_excl_col    = input.color(color.new(color.red,     75), "", inline="excl",  group="Sessions")
i_excl_day    = input.string("Wed/Thu", "Excl. Days", group="Sessions",
                  options=["Every Day", "Mon", "Tue", "Wed", "Thu", "Fri", "Wed/Thu"])

i_show_lunch  = input.bool(true,  "", inline="lunch", group="Sessions")
i_lunch_label = input.string("Lunch",     "", inline="lunch", group="Sessions")
i_lunch_ses   = input.session("1130-1330", "", inline="lunch", group="Sessions")
i_lunch_col   = input.color(color.new(color.yellow,  80), "", inline="lunch", group="Sessions")

i_show_pwr    = input.bool(true,  "", inline="pwr",   group="Sessions")
i_pwr_label   = input.string("Power Hour","", inline="pwr",   group="Sessions")
i_pwr_ses     = input.session("1400-1500", "", inline="pwr",   group="Sessions")
i_pwr_col     = input.color(color.new(color.fuchsia, 80), "", inline="pwr",   group="Sessions")

i_show_eeod   = input.bool(true,  "", inline="eeod",  group="Sessions")
i_eeod_label  = input.string("EEOD",      "", inline="eeod",  group="Sessions")
i_eeod_ses    = input.session("1830-2359", "", inline="eeod",  group="Sessions")
i_eeod_col    = input.color(color.new(color.green,   80), "", inline="eeod",  group="Sessions")

// NOTE: Add TradingView's built-in "Volume" indicator separately for volume bars.

// ═══════════════════════════════════════════════════════════════════════════
// SESSION BOUNDARY  (anchor: 19:00 Chicago = CME daily open)
// ═══════════════════════════════════════════════════════════════════════════

CT = "America/Chicago"
_ct_now   = hour(time, CT) * 60 + minute(time, CT)
_ct_prev  = hour(time[1], CT) * 60 + minute(time[1], CT)
int _sess_boundary = i_asset_mode == "Equities" ? 16 * 60 : 19 * 60
is_new_session = _ct_now >= _sess_boundary and _ct_prev < _sess_boundary

// ═══════════════════════════════════════════════════════════════════════════
// VWAP + STANDARD DEVIATION BANDS  (Welford online variance)
// ═══════════════════════════════════════════════════════════════════════════

var float _cum_tpv  = 0.0
var float _cum_vol  = 0.0
var float _cum_dev2 = 0.0

if is_new_session
    _cum_tpv  := 0.0
    _cum_vol  := 0.0
    _cum_dev2 := 0.0

float tp      = (high + low + close) / 3.0
float _oldvol = _cum_vol
_cum_tpv += tp * volume
_cum_vol += volume

float vwap_val = na
float vwap_sd  = na
if _cum_vol > 0
    vwap_val := _cum_tpv / _cum_vol
    if _oldvol > 0
        float _oldvwap = (_cum_tpv - tp * volume) / _oldvol
        _cum_dev2 += volume * (tp - _oldvwap) * (tp - vwap_val)
    vwap_sd := math.sqrt(math.max(0.0, _cum_dev2 / _cum_vol))

float vwap_p05 = i_show_vwap and i_show_05band ? vwap_val + 0.5 * vwap_sd : na
float vwap_m05 = i_show_vwap and i_show_05band ? vwap_val - 0.5 * vwap_sd : na
float vwap_p2  = i_show_vwap and i_show_2band  ? vwap_val + 2.0 * vwap_sd : na
float vwap_m2  = i_show_vwap and i_show_2band  ? vwap_val - 2.0 * vwap_sd : na
float vwap_p25 = i_show_vwap and i_show_2band  ? vwap_val + 2.5 * vwap_sd : na
float vwap_m25 = i_show_vwap and i_show_2band  ? vwap_val - 2.5 * vwap_sd : na

p_vwap = plot(i_show_vwap ? vwap_val : na, "VWAP",  color=color.yellow,               linewidth=2)
p_p05  = plot(vwap_p05,  "+0.5σ", color=color.new(color.gray, 30), linewidth=1)
p_m05  = plot(vwap_m05,  "−0.5σ", color=color.new(color.gray, 30), linewidth=1)
p_p2   = plot(vwap_p2,   "+2σ",   color=color.new(color.red,  30), linewidth=1)
p_m2   = plot(vwap_m2,   "−2σ",   color=color.new(color.red,  30), linewidth=1)
p_p25  = plot(vwap_p25,  "+2.5σ", color=color.new(color.red,  60), linewidth=1)
p_m25  = plot(vwap_m25,  "−2.5σ", color=color.new(color.red,  60), linewidth=1)
fill(p_p05, p_m05, color=color.new(color.gray, 88), title="0.5σ Fill")

// ═══════════════════════════════════════════════════════════════════════════
// BIG TRADES DETECTOR  (volume intensity z-score, tiered bubbles)
// ═══════════════════════════════════════════════════════════════════════════

float _btd_rng     = high - low
float raw_buy_vol  = _btd_rng == 0 ? 0.0 : (close - low)  / _btd_rng * volume
float raw_sell_vol = _btd_rng == 0 ? 0.0 : (high - close) / _btd_rng * volume

float avg_buy_vol  = ta.sma(raw_buy_vol,    i_btd_lookback)[1]
float std_buy_vol  = ta.stdev(raw_buy_vol,  i_btd_lookback)[1]
float avg_sell_vol = ta.sma(raw_sell_vol,   i_btd_lookback)[1]
float std_sell_vol = ta.stdev(raw_sell_vol, i_btd_lookback)[1]

float thresh_buy  = avg_buy_vol  + std_buy_vol  * i_btd_sigma
float thresh_sell = avg_sell_vol + std_sell_vol * i_btd_sigma

bool is_bt_buy_t1  = raw_buy_vol  > thresh_buy
bool is_bt_buy_t2  = raw_buy_vol  > avg_buy_vol  + std_buy_vol  * (i_btd_sigma + 1.5)
bool is_bt_buy_t3  = raw_buy_vol  > avg_buy_vol  + std_buy_vol  * (i_btd_sigma + 3.0)
bool is_bt_sell_t1 = raw_sell_vol > thresh_sell
bool is_bt_sell_t2 = raw_sell_vol > avg_sell_vol + std_sell_vol * (i_btd_sigma + 1.5)
bool is_bt_sell_t3 = raw_sell_vol > avg_sell_vol + std_sell_vol * (i_btd_sigma + 3.0)

float pos_buy  = math.avg(close, low)
float pos_sell = math.avg(close, high)

plotshape(i_show_btd and is_bt_buy_t1  and not is_bt_buy_t2  ? pos_buy  : na, title="Big Buy (Small)",  style=shape.circle, location=location.absolute, color=i_btd_buy_col,  size=size.small)
plotshape(i_show_btd and is_bt_buy_t2  and not is_bt_buy_t3  ? pos_buy  : na, title="Big Buy (Med)",    style=shape.circle, location=location.absolute, color=i_btd_buy_col,  size=size.normal)
plotshape(i_show_btd and is_bt_buy_t3                         ? pos_buy  : na, title="Big Buy (Large)",  style=shape.circle, location=location.absolute, color=i_btd_buy_col,  size=size.large)
plotshape(i_show_btd and is_bt_sell_t1 and not is_bt_sell_t2 ? pos_sell : na, title="Big Sell (Small)", style=shape.circle, location=location.absolute, color=i_btd_sell_col, size=size.small)
plotshape(i_show_btd and is_bt_sell_t2 and not is_bt_sell_t3 ? pos_sell : na, title="Big Sell (Med)",   style=shape.circle, location=location.absolute, color=i_btd_sell_col, size=size.normal)
plotshape(i_show_btd and is_bt_sell_t3                        ? pos_sell : na, title="Big Sell (Large)", style=shape.circle, location=location.absolute, color=i_btd_sell_col, size=size.large)

// ═══════════════════════════════════════════════════════════════════════════
// MOVING AVERAGE
// ═══════════════════════════════════════════════════════════════════════════

float _ma_val = i_ma_type == "EMA" ? ta.ema(close, i_ma_len) : ta.sma(close, i_ma_len)
plot(i_show_ma ? _ma_val : na, "MA", color=i_ma_col, linewidth=i_ma_width)

// ═══════════════════════════════════════════════════════════════════════════
// SESSIONS  — LuxAlgo bordered-box style with daily divider
// ═══════════════════════════════════════════════════════════════════════════

_tf = timeframe.period

// Numeric 0.0/1.0 session signals (feed into get_range transition logic)
float _s_ndo   = i_show_sess and i_show_ndo   ? math.sign(nz(time(_tf, i_ndo_ses,   i_sess_tz))) : 0.0
float _s_morn  = i_show_sess and i_show_morn  ? math.sign(nz(time(_tf, i_morn_ses,  i_sess_tz))) : 0.0
float _s_lunch = i_show_sess and i_show_lunch ? math.sign(nz(time(_tf, i_lunch_ses, i_sess_tz))) : 0.0
float _s_pwr   = i_show_sess and i_show_pwr   ? math.sign(nz(time(_tf, i_pwr_ses,   i_sess_tz))) : 0.0
float _s_eeod  = i_show_sess and i_show_eeod  ? math.sign(nz(time(_tf, i_eeod_ses,  i_sess_tz))) : 0.0

float _excl_raw    = math.sign(nz(time(_tf, i_excl_ses, i_sess_tz)))
bool  _excl_day_ok = switch i_excl_day
    "Mon"     => dayofweek == dayofweek.monday
    "Tue"     => dayofweek == dayofweek.tuesday
    "Wed"     => dayofweek == dayofweek.wednesday
    "Thu"     => dayofweek == dayofweek.thursday
    "Fri"     => dayofweek == dayofweek.friday
    "Wed/Thu" => dayofweek == dayofweek.wednesday or dayofweek == dayofweek.thursday
    => true
float _s_excl = i_show_sess and i_show_excl ? _excl_raw * (_excl_day_ok ? 1.0 : 0.0) : 0.0

// ── get_range: draw a live bordered box + label per session (LuxAlgo pattern)
// Reads bg_transp / show_outline / show_txt from outer input scope.
get_range(session, session_name, session_css, bstyle = line.style_dotted, lbl_below = false, show_fill = true) =>
    var int   _t   = 0
    var float _hi  = na
    var float _lo  = na
    var box   _bx  = na
    var label _lbl = na
    if session > session[1]
        _t  := time
        _hi := high
        _lo := low
        _bx := box.new(bar_index, _hi, bar_index, _lo,
                   bgcolor      = show_fill ? color.new(session_css, bg_transp) : color.new(color.black, 100),
                   border_color = show_outline ? session_css : na,
                   border_style = bstyle)
        if show_txt
            _lbl := label.new(_t, lbl_below ? _lo : _hi, session_name,
                       xloc      = xloc.bar_time,
                       textcolor = session_css,
                       style     = lbl_below ? label.style_label_up : label.style_label_down,
                       color     = color.new(color.white, 100),
                       size      = size.tiny)
    if session > 0 and session == session[1] and not na(_bx)
        _hi := math.max(high, _hi)
        _lo := math.min(low,  _lo)
        box.set_top(_bx, _hi)
        box.set_rightbottom(_bx, bar_index, _lo)
        if show_txt and not na(_lbl)
            label.set_xy(_lbl, int(math.avg(float(_t), float(time))), lbl_below ? _lo : _hi)

// Draw session boxes (called unconditionally so var state is tracked every bar)
get_range(_s_ndo,   i_ndo_label,   i_ndo_col,  line.style_dotted, false, false)
get_range(_s_morn,  i_morn_label,  i_morn_col, line.style_dotted, false, false)
get_range(_s_lunch, i_lunch_label, i_lunch_col, line.style_dotted, false, false)
get_range(_s_pwr,   i_pwr_label,   i_pwr_col,  line.style_dotted, false, false)
get_range(_s_eeod,  i_eeod_label,  i_eeod_col, line.style_dotted, false, false)
// Exclusion: full-height background (unmissable) + optional bordered box
bgcolor(_s_excl == 1.0 ? color.new(i_excl_col, 80) : na, title="Exclusion Zone")
get_range(_s_excl, i_excl_label, i_excl_col, line.style_solid, true)

// ── Daily Divider: dashed vertical line at 19:00 CT + day label at chart top
if is_new_session and show_day_div
    line.new(bar_index, close + syminfo.mintick, bar_index, close - syminfo.mintick,
             color=color.gray, extend=extend.both, style=line.style_dashed)

plotshape(is_new_session and show_day_div and dayofweek == dayofweek.sunday,    "Sun", shape.labeldown, location.top, color.new(color.white, 100), text="Sunday",    textcolor=color.gray, size=size.small, display=display.all - display.status_line, editable=false)
plotshape(is_new_session and show_day_div and dayofweek == dayofweek.monday,    "Mon", shape.labeldown, location.top, color.new(color.white, 100), text="Monday",    textcolor=color.gray, size=size.small, display=display.all - display.status_line, editable=false)
plotshape(is_new_session and show_day_div and dayofweek == dayofweek.tuesday,   "Tue", shape.labeldown, location.top, color.new(color.white, 100), text="Tuesday",   textcolor=color.gray, size=size.small, display=display.all - display.status_line, editable=false)
plotshape(is_new_session and show_day_div and dayofweek == dayofweek.wednesday, "Wed", shape.labeldown, location.top, color.new(color.white, 100), text="Wednesday", textcolor=color.gray, size=size.small, display=display.all - display.status_line, editable=false)
plotshape(is_new_session and show_day_div and dayofweek == dayofweek.thursday,  "Thu", shape.labeldown, location.top, color.new(color.white, 100), text="Thursday",  textcolor=color.gray, size=size.small, display=display.all - display.status_line, editable=false)
plotshape(is_new_session and show_day_div and dayofweek == dayofweek.friday,    "Fri", shape.labeldown, location.top, color.new(color.white, 100), text="Friday",    textcolor=color.gray, size=size.small, display=display.all - display.status_line, editable=false)
plotshape(is_new_session and show_day_div and dayofweek == dayofweek.saturday,  "Sat", shape.labeldown, location.top, color.new(color.white, 100), text="Saturday",  textcolor=color.gray, size=size.small, display=display.all - display.status_line, editable=false)

// ═══════════════════════════════════════════════════════════════════════════
// EXPECTED RANGE  — IV-implied daily move applied to 19:00 CT session open
// Formula: daily_move = DVOL / sqrt(365) / 100
//          Upper = session_open × (1 + daily_move)
//          Lower = session_open × (1 - daily_move)
// ═══════════════════════════════════════════════════════════════════════════

float _er_iv_sym_val = request.security(i_er_iv_sym, "D", close)
float _er_iv    = i_asset_mode == "Equities" ? i_er_iv_manual : _er_iv_sym_val
float _er_daily = not na(_er_iv) and _er_iv > 0 ? _er_iv / math.sqrt(365) / 100 : na

var float _er_open      = na
var int   _er_x1        = 0
var line  _er_uline     = na
var line  _er_lline     = na
var box   _er_ubox      = na
var box   _er_lbox      = na
var label _er_ulbl      = na
var label _er_llbl      = na
var line  _er_u40line   = na
var line  _er_u80line   = na
var line  _er_l40line   = na
var line  _er_l80line   = na
var box   _er_u40box    = na
var box   _er_l40box    = na
var box   _er_u80box    = na
var box   _er_l80box    = na
var label _er_u40lbl    = na
var label _er_u80lbl    = na
var label _er_l40lbl    = na
var label _er_l80lbl    = na

// ── Initialise new session objects at 19:00 CT ────────────────────────────

if is_new_session and i_show_er and not na(_er_daily)
    _er_open := i_asset_mode == "Equities" ? close : open
    _er_x1   := bar_index

    float _dist  = _er_open * _er_daily
    float _up    = _er_open + _dist
    float _dn    = _er_open - _dist
    float _up_40 = _er_open + _dist * 0.4
    float _up_80 = _er_open + _dist * 0.8
    float _dn_40 = _er_open - _dist * 0.4
    float _dn_80 = _er_open - _dist * 0.8
    float _pct   = math.floor(_er_iv / math.sqrt(365) * 100) / 100

    _er_uline   := line.new(_er_x1, _up, _er_x1, _up,
                             color=color.lime, width=3, style=line.style_solid)
    _er_lline   := line.new(_er_x1, _dn, _er_x1, _dn,
                             color=color.red,  width=3, style=line.style_solid)
    // Outer zones (0–40% and 80–100%): light fill
    _er_ubox    := box.new(_er_x1, _up_40, _er_x1, _er_open,
                            bgcolor=color.new(color.lime, 88), border_color=na)
    _er_lbox    := box.new(_er_x1, _er_open, _er_x1, _dn_40,
                            bgcolor=color.new(color.red,  88), border_color=na)
    _er_u80box  := box.new(_er_x1, _up, _er_x1, _up_80,
                            bgcolor=color.new(color.lime, 88), border_color=na)
    _er_l80box  := box.new(_er_x1, _dn_80, _er_x1, _dn,
                            bgcolor=color.new(color.red,  88), border_color=na)
    // Middle zone (40–80%): deeper fill
    _er_u40box  := box.new(_er_x1, _up_80, _er_x1, _up_40,
                            bgcolor=color.new(color.lime, 70), border_color=na)
    _er_l40box  := box.new(_er_x1, _dn_40, _er_x1, _dn_80,
                            bgcolor=color.new(color.red,  70), border_color=na)
    // Intermediate dashed lines at 40% and 80%
    _er_u40line := line.new(_er_x1, _up_40, _er_x1, _up_40,
                             color=color.new(color.lime, 40), width=1, style=line.style_dashed)
    _er_u80line := line.new(_er_x1, _up_80, _er_x1, _up_80,
                             color=color.new(color.lime, 40), width=1, style=line.style_dashed)
    _er_l40line := line.new(_er_x1, _dn_40, _er_x1, _dn_40,
                             color=color.new(color.red,  40), width=1, style=line.style_dashed)
    _er_l80line := line.new(_er_x1, _dn_80, _er_x1, _dn_80,
                             color=color.new(color.red,  40), width=1, style=line.style_dashed)
    // Intermediate labels
    _er_u40lbl  := label.new(_er_x1, _up_40, "40%",
                              textcolor=color.lime, style=label.style_label_down,
                              color=color.new(color.black, 100), size=size.tiny)
    _er_u80lbl  := label.new(_er_x1, _up_80, "80%",
                              textcolor=color.lime, style=label.style_label_down,
                              color=color.new(color.black, 100), size=size.tiny)
    _er_l40lbl  := label.new(_er_x1, _dn_40, "40%",
                              textcolor=color.red, style=label.style_label_up,
                              color=color.new(color.black, 100), size=size.tiny)
    _er_l80lbl  := label.new(_er_x1, _dn_80, "80%",
                              textcolor=color.red, style=label.style_label_up,
                              color=color.new(color.black, 100), size=size.tiny)
    _er_ulbl    := label.new(_er_x1, _up,
                              "Upper Bound: +" + str.tostring(_pct, "#.##") + "% (" + str.tostring(_up, format.mintick) + ")",
                              textcolor=color.lime, style=label.style_label_down,
                              color=color.new(color.black, 100), size=size.small)
    _er_llbl    := label.new(_er_x1, _dn,
                              "Lower Bound: -" + str.tostring(_pct, "#.##") + "% (" + str.tostring(_dn, format.mintick) + ")",
                              textcolor=color.red,  style=label.style_label_up,
                              color=color.new(color.black, 100), size=size.small)

// ── Update live: extend lines/boxes, refresh label text + position ────────

if i_show_er and not na(_er_open) and not na(_er_daily) and not is_new_session
    float _dist  = _er_open * _er_daily
    float _up    = _er_open + _dist
    float _dn    = _er_open - _dist
    float _up_40 = _er_open + _dist * 0.4
    float _up_80 = _er_open + _dist * 0.8
    float _dn_40 = _er_open - _dist * 0.4
    float _dn_80 = _er_open - _dist * 0.8
    float _pct   = math.floor(_er_iv / math.sqrt(365) * 100) / 100

    if not na(_er_uline)
        line.set_y1(_er_uline, _up)
        line.set_y2(_er_uline, _up)
        line.set_x2(_er_uline, bar_index)
    if not na(_er_lline)
        line.set_y1(_er_lline, _dn)
        line.set_y2(_er_lline, _dn)
        line.set_x2(_er_lline, bar_index)
    if not na(_er_ubox)
        box.set_top(_er_ubox,    _up_40)
        box.set_bottom(_er_ubox, _er_open)
        box.set_right(_er_ubox,  bar_index)
    if not na(_er_lbox)
        box.set_top(_er_lbox,    _er_open)
        box.set_bottom(_er_lbox, _dn_40)
        box.set_right(_er_lbox,  bar_index)
    if not na(_er_u80box)
        box.set_top(_er_u80box,    _up)
        box.set_bottom(_er_u80box, _up_80)
        box.set_right(_er_u80box,  bar_index)
    if not na(_er_l80box)
        box.set_top(_er_l80box,    _dn_80)
        box.set_bottom(_er_l80box, _dn)
        box.set_right(_er_l80box,  bar_index)
    if not na(_er_u40box)
        box.set_top(_er_u40box,    _up_80)
        box.set_bottom(_er_u40box, _up_40)
        box.set_right(_er_u40box,  bar_index)
    if not na(_er_l40box)
        box.set_top(_er_l40box,    _dn_40)
        box.set_bottom(_er_l40box, _dn_80)
        box.set_right(_er_l40box,  bar_index)
    if not na(_er_u40line)
        line.set_y1(_er_u40line, _up_40)
        line.set_y2(_er_u40line, _up_40)
        line.set_x2(_er_u40line, bar_index)
    if not na(_er_u80line)
        line.set_y1(_er_u80line, _up_80)
        line.set_y2(_er_u80line, _up_80)
        line.set_x2(_er_u80line, bar_index)
    if not na(_er_l40line)
        line.set_y1(_er_l40line, _dn_40)
        line.set_y2(_er_l40line, _dn_40)
        line.set_x2(_er_l40line, bar_index)
    if not na(_er_l80line)
        line.set_y1(_er_l80line, _dn_80)
        line.set_y2(_er_l80line, _dn_80)
        line.set_x2(_er_l80line, bar_index)
    if not na(_er_u40lbl)
        label.set_xy(_er_u40lbl, bar_index, _up_40)
    if not na(_er_u80lbl)
        label.set_xy(_er_u80lbl, bar_index, _up_80)
    if not na(_er_l40lbl)
        label.set_xy(_er_l40lbl, bar_index, _dn_40)
    if not na(_er_l80lbl)
        label.set_xy(_er_l80lbl, bar_index, _dn_80)
    if not na(_er_ulbl)
        label.set_xy(_er_ulbl, bar_index, _up)
        label.set_text(_er_ulbl, "Upper Bound: +" + str.tostring(_pct, "#.##") + "% (" + str.tostring(_up, format.mintick) + ")")
    if not na(_er_llbl)
        label.set_xy(_er_llbl, bar_index, _dn)
        label.set_text(_er_llbl, "Lower Bound: -" + str.tostring(_pct, "#.##") + "% (" + str.tostring(_dn, format.mintick) + ")")

// ── DVOL Dashboard ────────────────────────────────────────────────────────

var table _dvol_tb = table.new(position.bottom_right, 3, 1,
     bgcolor=#1e222d, border_color=#373a46, border_width=1,
     frame_color=#373a46, frame_width=1)

if barstate.islast and i_show_dvol_db
    string _sym_lbl  = i_asset_mode == "Equities" ? "Manual IV" : str.replace(i_er_iv_sym, "DERIBIT:", "")
    string _iv_str   = not na(_er_iv) ? str.tostring(_er_iv, "#.##") : "N/A"
    color  _iv_color = not na(_er_iv) ?
         _er_iv < 50  ? color.green  :
         _er_iv < 70  ? color.yellow :
         _er_iv < 90  ? color.orange : color.red
         : color.gray
    string _state    = not na(_er_iv) ?
         _er_iv < 50  ? "Full Progression" :
         _er_iv < 70  ? "3R Cap"           :
         _er_iv < 90  ? "5R Cap"           : "1R or None"
         : "N/A"
    table.cell(_dvol_tb, 0, 0, _sym_lbl, text_color=color.gray, text_size=size.small, bgcolor=#1e222d)
    table.cell(_dvol_tb, 1, 0, _iv_str,  text_color=_iv_color,  text_size=size.small, bgcolor=#1e222d)
    table.cell(_dvol_tb, 2, 0, _state,   text_color=_iv_color,  text_size=size.small, bgcolor=#1e222d)

// ═══════════════════════════════════════════════════════════════════════════
// SESSION OPEN LINE — dashed white line at 19:00 CT candle open
// ═══════════════════════════════════════════════════════════════════════════

var float _so_price = na
var line  _so_line  = na
var label _so_lbl   = na

if is_new_session and i_show_so
    line.delete(_so_line)
    label.delete(_so_lbl)
    _so_price := i_asset_mode == "Equities" ? close : open
    string _so_txt = i_asset_mode == "Equities" ? "Day Close" : "Session Open"
    _so_line  := line.new(bar_index, _so_price, bar_index + 1, _so_price,
                          color=color.white, style=line.style_dashed, width=1, extend=extend.right)
    _so_lbl   := label.new(bar_index, _so_price, _so_txt,
                           textcolor=color.white, style=label.style_label_left,
                           color=color.new(color.black, 100), size=size.small)

if i_show_so and not na(_so_line) and not is_new_session
    label.set_xy(_so_lbl, bar_index, _so_price)

// ═══════════════════════════════════════════════════════════════════════════
// USER LEVELS — Buy Territory / Sell Territory
// ═══════════════════════════════════════════════════════════════════════════

var line  _buy_line  = na
var label _buy_lbl   = na
var line  _sell_line = na
var label _sell_lbl  = na

if barstate.islast
    line.delete(_buy_line)
    label.delete(_buy_lbl)
    line.delete(_sell_line)
    label.delete(_sell_lbl)
    _buy_line  := i_show_buy_lvl  and i_buy_lvl  != 0 ? line.new(bar_index, i_buy_lvl,  bar_index - 1, i_buy_lvl,  color=color.white, style=line.style_dotted, width=1, extend=extend.both) : na
    _buy_lbl   := i_show_buy_lvl  and i_buy_lvl  != 0 ? label.new(bar_index, i_buy_lvl,  "Buy Territory",  textcolor=color.white, style=label.style_label_left, color=color.new(color.black, 100), size=size.small) : na
    _sell_line := i_show_sell_lvl and i_sell_lvl != 0 ? line.new(bar_index, i_sell_lvl, bar_index - 1, i_sell_lvl, color=color.white, style=line.style_dotted, width=1, extend=extend.both) : na
    _sell_lbl  := i_show_sell_lvl and i_sell_lvl != 0 ? label.new(bar_index, i_sell_lvl, "Sell Territory", textcolor=color.white, style=label.style_label_left, color=color.new(color.black, 100), size=size.small) : na
